//// Generated by `gleam run -m genesis_prime/table_generator` from the client's DB/LuaEvent.tbl.
//// The client's LuaEvent table: its row type, its schema and the decoder
//// of its records. The layout is the client's (game_table.file, game_table.schema
//// and game_table.column_type in the fact file); the table loads only when its
//// file's header equals `schema`.
//// Rows keep plain `Int` ids: typed ids in the client's 26,362,088 id cells would add about 603 MB (measured); `get` and the readers give the typed ids of `genesis_prime/table/id`.

import genesis_prime/table/id.{type LuaEventId, LuaEventId}
import genesis_prime/table/loader/store
import genesis_prime/table/loader/tbl_file
import gleam/result

/// One row of the client's LuaEvent table.
pub type LuaEvent {
  LuaEvent(id: Int, event_name: String, parameters: String)
}

/// The layout of the client's LuaEvent table: its name, record size and
/// columns, which a file must equal to be loaded.
pub const schema =
  tbl_file.Schema(
    table: "LuaEvent",
    file: "LuaEvent",
    record_size: 24,
    columns: [
      tbl_file.Column(name: "ID", column_type: tbl_file.Integer32),
      tbl_file.Column(name: "eventName", column_type: tbl_file.Utf16Text),
      tbl_file.Column(name: "parameters", column_type: tbl_file.Utf16Text),
    ],
  )

/// The entry that loads the LuaEvent table.
pub fn entry() -> store.Entry {
  store.entry(schema:, decode: decode_record, id: row_id)
}

/// The row of the LuaEvent table with the id, or an error when it has none.
pub fn get(
  tables tables: store.Tables,
  id id: LuaEventId,
) -> Result(LuaEvent, Nil) {
  store.row(tables, schema.table, id.value)
}

/// Every row of the LuaEvent table, in id order.
pub fn all(tables: store.Tables) -> List(LuaEvent) {
  store.rows(tables, schema.table)
}

/// The row's own id, as the typed id of its table.
pub fn id(row: LuaEvent) -> LuaEventId {
  LuaEventId(row.id)
}

fn row_id(row: LuaEvent) -> Int {
  row.id
}

fn decode_record(
  record record: BitArray,
  strings strings: tbl_file.Strings,
) -> Result(LuaEvent, tbl_file.RecordError) {
  case record {
    <<
      c0:size(32)-little-signed,
      _:size(32),
      c1:size(64)-little,
      c2:size(64)-little,
      _:bits,
    >> -> {
      use c1 <- result.try(tbl_file.text(strings, c1, "eventName"))
      use c2 <- result.try(tbl_file.text(strings, c2, "parameters"))
      Ok(LuaEvent(id: c0, event_name: c1, parameters: c2))
    }
    _ -> Error(tbl_file.NotARecord)
  }
}
