/// The layout of the client's ModelMesh table: its name, record size and
/// columns, which a file must equal to be loaded.
pub const schema =
  tbl_file.Schema(
    table: "ModelMesh",
    file: "ModelMesh",
    record_size: 16,
    columns: [
      tbl_file.Column(name: "ID", column_type: tbl_file.Integer32),
      tbl_file.Column(name: "EnumName", column_type: tbl_file.Utf16Text),
    ],
  )

/// The entry that loads the ModelMesh table.
