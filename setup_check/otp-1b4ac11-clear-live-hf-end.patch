From 1b4ac11107d020e3fedc708d4d0f490f7edb0b3e Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Lukas=20Backstr=C3=B6m?= <lukas@erlang.org>
Date: Tue, 27 Oct 2026 15:41:57 +0100
Subject: [PATCH] erts: Clear live_hf_end flag when disabled GC is re-enabled

Before this fix, it was possible for a disabled GC to set the live_hf_end marker
and then re-enable itself without clearing the live_hf_end marker. This would cause
the next gc (which could happen a long time later) to consider all the heap framents
created since the first disabled GC to be 100% live. This made the heap grow much
larger than it should.

The fix for this is to make sure we clear the live_hf_end marker when the GC is enabled
again, or when a GC actually happend in garbage_collect_lhf.

fixes #11923

Backported to 29.1.2 as OTP's maint merge 99c8b6a20b spells it.
---
 erts/emulator/beam/emu/bif_instrs.tab      |  6 +++++
 erts/emulator/beam/erl_gc.c                | 12 +++++++--
 erts/emulator/beam/erl_gc.h                |  3 ++-
 erts/emulator/beam/jit/arm/instr_bif.cpp   |  8 ++++++
 erts/emulator/beam/jit/beam_jit_common.cpp |  5 ++++
 erts/emulator/beam/jit/x86/instr_bif.cpp   |  8 ++++++
 erts/emulator/test/gc_SUITE.erl            | 31 ++++++++++++++++++++--
 7 files changed, 68 insertions(+), 5 deletions(-)

diff --git a/erts/emulator/beam/emu/bif_instrs.tab b/erts/emulator/beam/emu/bif_instrs.tab
--- a/erts/emulator/beam/emu/bif_instrs.tab
+++ b/erts/emulator/beam/emu/bif_instrs.tab
@@ -274,6 +274,8 @@ call_light_bif(Bif, Exp) {
         result = erts_gc_after_bif_call_lhf(c_p, live_hf_end, result,
                                             reg, arity);
         E = c_p->stop;
+    } else if (c_p->live_hf_end != ERTS_INVALID_HFRAG_PTR) {
+        c_p->live_hf_end = ERTS_INVALID_HFRAG_PTR;
     }
     HTOP = HEAP_TOP(c_p);
     FCALLS = c_p->fcalls;
@@ -375,6 +377,8 @@ call_light_bif_only(Bif, Exp) {
         result = erts_gc_after_bif_call_lhf(c_p, live_hf_end, result,
                                             reg, arity);
         E = c_p->stop;
+    } else if (c_p->live_hf_end != ERTS_INVALID_HFRAG_PTR) {
+        c_p->live_hf_end = ERTS_INVALID_HFRAG_PTR;
     }
     HTOP = HEAP_TOP(c_p);
     FCALLS = c_p->fcalls;
@@ -609,6 +613,8 @@ nif_bif.epilogue() {
         nif_bif_result = erts_gc_after_bif_call_lhf(c_p, live_hf_end,
                                                     nif_bif_result,
                                                     reg, bif_nif_arity);
+    } else if (c_p->live_hf_end != ERTS_INVALID_HFRAG_PTR) {
+        c_p->live_hf_end = ERTS_INVALID_HFRAG_PTR;
     }
     SWAPIN;  /* There might have been a garbage collection. */
     FCALLS = c_p->fcalls;
diff --git a/erts/emulator/beam/erl_gc.c b/erts/emulator/beam/erl_gc.c
--- a/erts/emulator/beam/erl_gc.c
+++ b/erts/emulator/beam/erl_gc.c
@@ -423,6 +423,7 @@ erts_gc_after_bif_call_lhf(Process* p, ErlHeapFragment *live_hf_end,
     if (!p->mbuf) {
         /* Must have GC:d in BIF call... invalidate live_hf_end */
         live_hf_end = ERTS_INVALID_HFRAG_PTR;
+        p->live_hf_end = ERTS_INVALID_HFRAG_PTR;
     }
 
     if (p->flags & (F_HIBERNATE_SCHED | F_DISABLE_GC)) {
@@ -445,6 +446,12 @@ erts_gc_after_bif_call_lhf(Process* p, ErlHeapFragment *live_hf_end,
 	return result;
     }
 
+    /* Consume the marker from the completed trapping BIF exactly once. */
+    if (p->live_hf_end != ERTS_INVALID_HFRAG_PTR) {
+        live_hf_end = p->live_hf_end;
+        p->live_hf_end = ERTS_INVALID_HFRAG_PTR;
+    }
+
     if (p->sig_qs.flags & (FS_ON_HEAP_MSGQ|FS_OFF_HEAP_MSGQ_CHNG)) {
         erts_proc_lock(p, ERTS_PROC_LOCK_MSGQ);
         erts_proc_sig_fetch(p);
@@ -792,10 +799,11 @@ garbage_collect(Process* p, ErlHeapFragment *live_hf_end,
 	    goto delay_gc_before_start;
     }
 
+    /* A saved marker is consumed by erts_gc_after_bif_call_lhf. */
+    ASSERT(p->live_hf_end == ERTS_INVALID_HFRAG_PTR);
+
     if (p->abandoned_heap)
 	live_hf_end = ERTS_INVALID_HFRAG_PTR;
-    else if (p->live_hf_end != ERTS_INVALID_HFRAG_PTR)
-	live_hf_end = p->live_hf_end;
 
     ERTS_MSACC_SET_STATE_CACHED(ERTS_MSACC_STATE_GC);
 
diff --git a/erts/emulator/beam/erl_gc.h b/erts/emulator/beam/erl_gc.h
--- a/erts/emulator/beam/erl_gc.h
+++ b/erts/emulator/beam/erl_gc.h
@@ -139,7 +139,8 @@ ERTS_GLB_INLINE Eterm follow_moved(Eterm term, Eterm xptr_tag)
 
 /* ERTS_IS_GC_AFTER_BIF_DESIRED also triggers for flag F_DISABLE_GC,
  * not to actually do GC but we need to call erts_gc_after_bif_call_lhf
- * for some bookkeeping of live_hf_end. */
+ * for some bookkeeping of live_hf_end. When it is false, a saved
+ * live_hf_end marker must be cleared by the caller. */
 #define ERTS_IS_GC_AFTER_BIF_DESIRED(Proc)			        \
     ERTS_IS_GC_DESIRED_INTERNAL((Proc), (Proc)->htop, (Proc)->stop, F_DISABLE_GC)
 
diff --git a/erts/emulator/beam/jit/arm/instr_bif.cpp b/erts/emulator/beam/jit/arm/instr_bif.cpp
--- a/erts/emulator/beam/jit/arm/instr_bif.cpp
+++ b/erts/emulator/beam/jit/arm/instr_bif.cpp
@@ -511,6 +511,14 @@ void BeamGlobalAssembler::emit_call_light_bif_shared() {
              * Otherwise, set the flags as if it is to force a GC. */
             a.ccmp(TMP1, TMP2, imm(NZCV::kVF), imm(arm::CondCode::kLS));
             a.b_lt(gc_after_bif_call);
+
+            /* No GC is needed, so a saved live_hf_end marker is no longer
+             * valid. Clear it unless it is already cleared. */
+            a.ldr(TMP1, a64::Mem(c_p, offsetof(Process, live_hf_end)));
+            mov_imm(TMP2, (UWord)ERTS_INVALID_HFRAG_PTR);
+            a.cmp(TMP1, TMP2);
+            a.b_eq(check_bif_return);
+            a.str(TMP2, a64::Mem(c_p, offsetof(Process, live_hf_end)));
         }
 
         a.bind(check_bif_return);
diff --git a/erts/emulator/beam/jit/beam_jit_common.cpp b/erts/emulator/beam/jit/beam_jit_common.cpp
--- a/erts/emulator/beam/jit/beam_jit_common.cpp
+++ b/erts/emulator/beam/jit/beam_jit_common.cpp
@@ -615,6 +615,8 @@ Eterm beam_jit_call_bif(Process *c_p,
                                             result,
                                             reg,
                                             arity);
+    } else if (c_p->live_hf_end != ERTS_INVALID_HFRAG_PTR) {
+        c_p->live_hf_end = ERTS_INVALID_HFRAG_PTR;
     }
 
     return result;
@@ -671,6 +673,9 @@ Eterm beam_jit_call_nif(Process *c_p,
                                                     nif_bif_result,
                                                     reg,
                                                     bif_nif_arity);
+    } else {
+        /* NIFs cannot disable GC, so there is no marker to clear. */
+        ASSERT(c_p->live_hf_end == ERTS_INVALID_HFRAG_PTR);
     }
 
     return nif_bif_result;
diff --git a/erts/emulator/beam/jit/x86/instr_bif.cpp b/erts/emulator/beam/jit/x86/instr_bif.cpp
--- a/erts/emulator/beam/jit/x86/instr_bif.cpp
+++ b/erts/emulator/beam/jit/x86/instr_bif.cpp
@@ -552,6 +552,14 @@ void BeamGlobalAssembler::emit_call_light_bif_shared() {
             a.lea(ARG1, x86::qword_ptr(HTOP, ARG2, 0, 3));
             a.cmp(E, ARG1);
             a.jl(gc_after_bif_call);
+
+            /* No GC is needed, so a saved live_hf_end marker is no longer
+             * valid. Clear it unless it is already cleared. */
+            a.cmp(x86::qword_ptr(c_p, offsetof(Process, live_hf_end)),
+                  imm((Sint)ERTS_INVALID_HFRAG_PTR));
+            a.short_().je(check_bif_return);
+            a.mov(x86::qword_ptr(c_p, offsetof(Process, live_hf_end)),
+                  imm((Sint)ERTS_INVALID_HFRAG_PTR));
         }
 
         /* ! FALL THROUGH ! */
diff --git a/erts/emulator/test/gc_SUITE.erl b/erts/emulator/test/gc_SUITE.erl
--- a/erts/emulator/test/gc_SUITE.erl
+++ b/erts/emulator/test/gc_SUITE.erl
@@ -39,7 +39,8 @@
     minor_major_gc_option_self/1,
     gc_signal_order/1,
     gc_dirty_exec_proc/1,
-    alias_signals_in_gc/1
+    alias_signals_in_gc/1,
+    trapping_bif_live_hf_end/1
 ]).
 
 suite() ->
@@ -50,7 +51,7 @@ all() ->
      max_heap_size_large_hfrag,
     minor_major_gc_option_self,
     minor_major_gc_option_async, gc_signal_order, gc_dirty_exec_proc,
-    alias_signals_in_gc].
+    alias_signals_in_gc, trapping_bif_live_hf_end].
 
 
 %% Produce a growing list of elements,
@@ -410,3 +411,29 @@ do_gc(N) ->
     garbage_collect(),
     receive after 100 -> ok end,
     do_gc(N-1).
+
+%% A BIF that traps with GC disabled saves a live_hf_end marker. The marker
+%% must be consumed when the BIF returns, even if no GC is needed, or it
+%% would be reused by a later unrelated GC (GH-11923). Builds assert
+%% that no marker is left when a GC starts.
+trapping_bif_live_hf_end(Config) when is_list(Config) ->
+    Map = maps:from_list([{I, I} || I <- lists:seq(1, 2500)]),
+    Self = self(),
+    Fun = fun() ->
+                  Self ! {self(), trapping_bif_loop(Map, 200)}
+          end,
+    Pids = [spawn_opt(Fun, [{min_heap_size, Sz}, {message_queue_data, MQD}])
+            || Sz <- [233, 100000, 4000000],
+               MQD <- [on_heap, off_heap]],
+    [receive {Pid, ok} -> ok end || Pid <- Pids],
+    ok.
+
+trapping_bif_loop(_Map, 0) ->
+    ok;
+trapping_bif_loop(Map, N) ->
+    2500 = length(maps:keys(Map)),
+    case N rem 50 of
+        0 -> erlang:garbage_collect();
+        _ -> ok
+    end,
+    trapping_bif_loop(Map, N - 1).
