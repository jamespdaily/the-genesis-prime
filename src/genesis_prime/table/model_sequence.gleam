fn decode_record(
  record record: BitArray,
  strings strings: tbl_file.Strings,
) -> Result(ModelSequence, tbl_file.RecordError) {
  case record {
    <<
      c0:size(32)-little-signed,
      _:size(32),
      c1:size(64)-little,
      c2:size(32)-little-signed,
      c3:size(32)-little-signed,
      _:bits,
    >> -> {
      use c1 <- result.try(tbl_file.text(strings, c1, "description"))
      Ok(ModelSequence(id: c0, description: c1, fall_back_id: c2, flag: c3))
    }
    _ -> Error(tbl_file.NotARecord)
  }
