/// The row of the Spline2 table with the id, or an error when it has none.
pub fn get(tables tables: store.Tables, id id: Int) -> Result(Spline2, Nil) {
  store.row(tables, schema.table, id)
}

/// Every row of the Spline2 table, in id order.
pub fn all(tables: store.Tables) -> List(Spline2) {
  store.rows(tables, schema.table)
}

fn row_id(row: Spline2) -> Int {
  row.id
}

fn decode_record(
  record record: BitArray,
  strings _strings: tbl_file.Strings,
) -> Result(Spline2, tbl_file.RecordError) {
