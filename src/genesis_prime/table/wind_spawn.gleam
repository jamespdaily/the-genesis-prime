//// Generated by `gleam run -m genesis_prime/table_generator` from the client's DB/WindSpawn.tbl.
//// The client's WindSpawn table: its row type, its schema and the decoder
//// of its records. The layout is the client's (game_table.file, game_table.schema
//// and game_table.column_type in the fact file); the table loads only when its
//// file's header equals `schema`.
//// Rows keep plain `Int` ids: typed ids in the client's 26,362,088 id cells would add about 603 MB (measured); `get` and the readers give the typed ids of `genesis_prime/table/id`.

import genesis_prime/table/id.{type WindSpawnId, WindSpawnId}
import genesis_prime/table/loader/store
import genesis_prime/table/loader/tbl_file

/// One row of the client's WindSpawn table.
pub type WindSpawn {
  WindSpawn(
    id: Int,
    interval_min: Int,
    interval_max: Int,
    direction_min: Float,
    direction_max: Float,
  )
}

/// The layout of the client's WindSpawn table: its name, record size and
/// columns, which a file must equal to be loaded.
pub const schema =
  tbl_file.Schema(
    table: "WindSpawn",
    file: "WindSpawn",
    record_size: 20,
    columns: [
      tbl_file.Column(name: "ID", column_type: tbl_file.Integer32),
      tbl_file.Column(name: "intervalMin", column_type: tbl_file.Integer32),
      tbl_file.Column(name: "intervalMax", column_type: tbl_file.Integer32),
      tbl_file.Column(name: "directionMin", column_type: tbl_file.Float32),
      tbl_file.Column(name: "directionMax", column_type: tbl_file.Float32),
    ],
  )

/// The entry that loads the WindSpawn table.
pub fn entry() -> store.Entry {
  store.entry(schema:, decode: decode_record, id: row_id)
}

/// The row of the WindSpawn table with the id, or an error when it has none.
pub fn get(
  tables tables: store.Tables,
  id id: WindSpawnId,
) -> Result(WindSpawn, Nil) {
  store.row(tables, schema.table, id.value)
}

/// Every row of the WindSpawn table, in id order.
pub fn all(tables: store.Tables) -> List(WindSpawn) {
  store.rows(tables, schema.table)
}

/// The row's own id, as the typed id of its table.
pub fn id(row: WindSpawn) -> WindSpawnId {
  WindSpawnId(row.id)
}

fn row_id(row: WindSpawn) -> Int {
  row.id
}

fn decode_record(
  record record: BitArray,
  strings _strings: tbl_file.Strings,
) -> Result(WindSpawn, tbl_file.RecordError) {
  case record {
    <<
      c0:size(32)-little-signed,
      c1:size(32)-little-signed,
      c2:size(32)-little-signed,
      c3:size(32)-little-float,
      c4:size(32)-little-float,
      _:bits,
    >> -> {
      Ok(WindSpawn(
        id: c0,
        interval_min: c1,
        interval_max: c2,
        direction_min: c3,
        direction_max: c4,
      ))
    }
    _ -> Error(tbl_file.NotARecord)
  }
}
