    <<
      c0:size(32)-little-signed,
      c1:size(32)-little-signed,
      c2:size(32)-little-signed,
      c3:size(32)-little-signed,
      c4:size(32)-little-signed,
      c5:size(32)-little-signed,
      c6:size(32)-little-signed,
      _:size(32),
      c7:size(64)-little,
      _:bits,
    >> -> {
      use c7 <- result.try(tbl_file.text(strings, c7, "buttonIcon"))
      Ok(Entitlement(
        id: c0,
        max_count: c1,
        flags: c2,
        spell4_id_persistent_buff: c3,
        character_title_id: c4,
        localized_text_id_name: c5,
        localized_text_id_description: c6,
        button_icon: c7,
      ))
    }
    _ -> Error(tbl_file.NotARecord)
  }
