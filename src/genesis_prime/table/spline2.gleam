/// The layout of the client's Spline2 table: its name, record size and
/// columns, which a file must equal to be loaded.
pub const schema =
  tbl_file.Schema(
    table: "Spline2",
    file: "Spline2",
    record_size: 12,
    columns: [
      tbl_file.Column(name: "ID", column_type: tbl_file.Integer32),
      tbl_file.Column(name: "worldId", column_type: tbl_file.Integer32),
      tbl_file.Column(name: "splineType", column_type: tbl_file.Integer32),
    ],
  )

/// The entry that loads the Spline2 table.
pub fn entry() -> store.Entry {
  store.entry(schema:, decode: decode_record, id: row_id)
