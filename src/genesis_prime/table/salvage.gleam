//// Generated by `gleam run -m genesis_prime/table_generator` from the client's DB/Salvage.tbl.
//// The client's Salvage table: its row type, its schema and the decoder
//// of its records. The layout is the client's (game_table.file, game_table.schema
//// and game_table.column_type in the fact file); the table loads only when its
//// file's header equals `schema`. Rows keep plain `Int` ids; `get` and the readers give the typed ids of `genesis_prime/table/id`, whose doc says why.

import genesis_prime/table/id.{
  type Item2TypeId, type SalvageId, Item2TypeId, SalvageId,
}
import genesis_prime/table/loader/store
import genesis_prime/table/loader/tbl_file

/// One row of the client's Salvage table.
