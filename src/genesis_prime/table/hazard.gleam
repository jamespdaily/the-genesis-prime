      c10:size(32)-little-float,
      c11:size(32)-little-float,
      c12:size(32)-little-signed,
      c13:size(32)-little-signed,
      c14:size(32)-little-signed,
      _:bits,
    >> -> {
      Ok(Hazard(
        id: c0,
        localized_text_id_name: c1,
        localized_text_id_tooltip: c2,
        meter_change_rate: c3,
        meter_max_value: c4,
