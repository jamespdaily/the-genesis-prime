//// Generated by `gleam run -m genesis_prime/table_generator` from the client's DB/HookAsset.tbl.
//// The client's HookAsset table: its row type, its schema and the decoder
//// of its records. The layout is the client's (game_table.file, game_table.schema
//// and game_table.column_type in the fact file); the table loads only when its
//// file's header equals `schema`.
//// Rows keep plain `Int` ids: typed ids in the client's 26,362,088 id cells would add about 603 MB (measured); `get` and the readers give the typed ids of `genesis_prime/table/id`.

import genesis_prime/table/id.{type HookAssetId, HookAssetId}
import genesis_prime/table/loader/store
import genesis_prime/table/loader/tbl_file
import gleam/result

/// One row of the client's HookAsset table.
pub type HookAsset {
  HookAsset(
    id: Int,
    asset: String,
    scale: Float,
    offset_x: Float,
    offset_y: Float,
    offset_z: Float,
    rotation_x: Float,
    rotation_y: Float,
    rotation_z: Float,
  )
}

/// The layout of the client's HookAsset table: its name, record size and
/// columns, which a file must equal to be loaded.
pub const schema =
  tbl_file.Schema(
    table: "HookAsset",
    file: "HookAsset",
    record_size: 48,
    columns: [
      tbl_file.Column(name: "ID", column_type: tbl_file.Integer32),
      tbl_file.Column(name: "asset", column_type: tbl_file.Utf16Text),
      tbl_file.Column(name: "scale", column_type: tbl_file.Float32),
      tbl_file.Column(name: "offsetX", column_type: tbl_file.Float32),
      tbl_file.Column(name: "offsetY", column_type: tbl_file.Float32),
      tbl_file.Column(name: "offsetZ", column_type: tbl_file.Float32),
      tbl_file.Column(name: "rotationX", column_type: tbl_file.Float32),
      tbl_file.Column(name: "rotationY", column_type: tbl_file.Float32),
      tbl_file.Column(name: "rotationZ", column_type: tbl_file.Float32),
    ],
  )

/// The entry that loads the HookAsset table.
pub fn entry() -> store.Entry {
  store.entry(schema:, decode: decode_record, id: row_id)
}

/// The row of the HookAsset table with the id, or an error when it has none.
pub fn get(
  tables tables: store.Tables,
  id id: HookAssetId,
) -> Result(HookAsset, Nil) {
  store.row(tables, schema.table, id.value)
}

/// Every row of the HookAsset table, in id order.
pub fn all(tables: store.Tables) -> List(HookAsset) {
  store.rows(tables, schema.table)
}

/// The row's own id, as the typed id of its table.
pub fn id(row: HookAsset) -> HookAssetId {
  HookAssetId(row.id)
}

fn row_id(row: HookAsset) -> Int {
  row.id
}

fn decode_record(
  record record: BitArray,
  strings strings: tbl_file.Strings,
) -> Result(HookAsset, tbl_file.RecordError) {
  case record {
    <<
      c0:size(32)-little-signed,
      _:size(32),
      c1:size(64)-little,
      c2:size(32)-little-float,
      c3:size(32)-little-float,
      c4:size(32)-little-float,
      c5:size(32)-little-float,
      c6:size(32)-little-float,
      c7:size(32)-little-float,
      c8:size(32)-little-float,
      _:bits,
    >> -> {
      use c1 <- result.try(tbl_file.text(strings, c1, "asset"))
      Ok(HookAsset(
        id: c0,
        asset: c1,
        scale: c2,
        offset_x: c3,
        offset_y: c4,
        offset_z: c5,
        rotation_x: c6,
        rotation_y: c7,
        rotation_z: c8,
      ))
    }
    _ -> Error(tbl_file.NotARecord)
  }
}
