//// What differs between the code the generator writes and the code in the
//// repository: a file with other text, a file the generator writes that the
//// repository lacks, and a generated file the generator no longer writes.

import gleam/dict.{type Dict}

/// One way the committed code differs from what the generator writes.
pub type Difference {
  /// The committed file's text is not what the generator writes.
  Changed(path: String)
  /// The generator writes the file and the repository has none.
  Missing(path: String)
  /// The repository has a generated file the generator does not write.
  Extra(path: String)
}

/// The text every generated file starts with.
pub const generated_marker =
  "//// Generated by `gleam run -m genesis_prime/table_generator`"

/// The differences between the generated files and the committed ones, both as
/// path to text, in path order. A committed file counts as generated when its
/// text starts with the marker; any other committed file is the repository's own.
pub fn between(
  generated generated: Dict(String, String),
  committed committed: Dict(String, String),
) -> List(Difference) {
