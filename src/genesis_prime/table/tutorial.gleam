        id: c0,
        flags: c1,
        tutorial_category_enum: c2,
        localized_text_id_contextual_popup: c3,
        tutorial_anchor_id: c4,
        required_level: c5,
        prerequisite_id: c6,
      ))
    }
    _ -> Error(tbl_file.NotARecord)
  }
