/// The 14 ids sent directly, in message 0x244 on the connection they are
/// given, not through a world or game sender (fact 0x140332920,
/// SerialiseMessageById): 0x7e0 on character select, 0x6e7, 0x7dd, 0x25c with
/// the whole frame of 0x25b, 0x352, 0x786, 0x3ee, 0x142, 0x58f, 0x592 on the
/// auth connection, 0x7a4 on realm select, 0x7df and 0x241.
const direct = [
  0x7E0, 0x6E7, 0x7DD, 0x25C, 0x25B, 0x352, 0x786, 0x3EE, 0x142, 0x58F, 0x592,
  0x7A4, 0x7DF, 0x241,
]

/// Message 0x244, the wrapper every other message travels in, and 0x38c, the
/// wrapper of a world message (fact 0x1403f4900), and the network layer's own
/// ids 0, 1 and 2, sent bare and never registered (fact 0x140332580).
const wrappers_and_base = [0x244, 0x38C, 0, 1, 2]

/// Every message id the client sends, in ascending order: 352 in all (fact
/// 0x1403309a0, RegisterMessage: with 0x244, 0x38c and ids 0, 1 and 2 the
/// client sends 352 ids). No id is in two of the lists.
pub fn all() -> List(Int) {
  [
    world_sender,
    world_kind_0b_sender,
    game_kind_0b_sender,
    game_kind_13_sender,
    direct,
    wrappers_and_base,
  ]
  |> list.flatten
  |> list.sort(int.compare)
}
