#!/usr/bin/env bash
# The full check, run locally and in CI (.github/workflows/check.yml).
#
# Usage: ./check          every part, the gate before a merge
#        ./check fast     format, gleam-build, glinter and code-rules only, for
#                         the loop while editing
#
# The wall time counts from the start of this script, setup check included. The
# budget is a target: GENESIS_CHECK_BUDGET_SECONDS (default 120; ./check fast has
# its own, GENESIS_CHECK_FAST_BUDGET_SECONDS). A run that ends over its budget passes
# and prints a warning line with its wall time and its budget, because a loaded
# machine (two agents testing at once, a cold build) turns correct code into a
# slow run. Only a hung run fails: one still going at three times its budget has
# everything the check started stopped, and each part that was running is
# reported as hung. A part that ends without writing its status fails the check
# by name.
#
# The full check chooses its scope from the files the branch changes since its
# merge base with origin/main (or main): uncommitted and untracked files count,
# and a deleted or renamed file counts under both of its names. When there is at
# least one and every one is in the light set (light_set below: guidance, CI's
# workflow, the licence, .gitignore and the untested shell and Python tools under
# dev/, apply_migrations.sh excepted), it runs only the parts of ./check fast,
# with ./check fast's budget, prints one `scope: light` line saying why, and ends
# with `check passed (scope: light)`. Every other case runs every part and prints
# a `scope: every part` line with the reason: any other changed file, no changed
# file, no merge base, a shallow history, a failed diff or ls-files, and CI's
# machine (GENESIS_NO_CLIENT=1 or GITHUB_ACTIONS set), which so always runs every
# part. branch-current and the setup check run first in either scope.
#
# The client scripts' integration tests take about 240 seconds, so they
# run only when the branch changes a file under the client scripts folder since
# its merge base with origin/main (or main), and then the budget is raised to
# GENESIS_CHECK_INTEGRATION_BUDGET_SECONDS (three times that is the hang limit)
# and the output says so.
#
# The full check starts with branch-current: HEAD must hold every commit of
# origin/main as last fetched (git rev-list --count HEAD..origin/main; the check
# fetches nothing). A branch that lacks any fails the check at once, naming how
# many commits and the tip compared and saying to merge origin/main, and no other
# part runs, setup check included. Where there is no origin/main (CI's checkout
# fetches only the merge ref, which holds main by construction) the part is
# skipped and the output says so; so is a shallow history (CI's pushes to main),
# where the count of commits HEAD lacks can include commits it holds.
# ./check fast does not run it.
#
# Then the setup check (./setup-check): it names every part this machine is
# missing, and when it fails nothing else runs. Before it, this script reads
# $GENESIS_HOME/env.sh (default ~/.genesis-prime/env.sh) and puts
# $GENESIS_OTP_DIR/bin first on PATH, unless GENESIS_NO_CLIENT=1 and
# GENESIS_OTP_DIR is unset (setup_check/environment.sh).
#
# Then the parts, independent ones side by side; a part that fails is named, and the
# script exits non-zero:
#   format         gleam format --check src test dev
#   gleam-build    gleam build --warnings-as-errors
#   glinter        gleam run -m glinter                 (after gleam-build)
#   generated-tables  gleam run -m genesis_prime/table_generator check
#                  regenerates src/genesis_prime/table* from the client's
#                  game tables in $GENESIS_TABLE_DIR (setup_check/extract_tables.py
#                  fills it) and compares; skipped where GENESIS_NO_CLIENT=1
#                                                       (after gleam-build)
#   gleam-test     gleam test, with GENESIS_TEST_WORKERS module groups at
#                  once (default 1; each group also runs its tests at once),
#                  then the tests tagged serial, one at a time
#                                                       (after gleam-build)
#   literal-area   the test run's room for persistent terms: the highest carriers
#                  size of the literal allocator (the region the VM keeps its
#                  persistent terms in, 1 GiB) that the first test run recorded
#                  (test/literal_area.gleam), against literal_limit_percent of
#                  the region. Fails over the limit, and when the run recorded
#                  nothing or ERL_FLAGS, ERL_AFLAGS, ERL_ZFLAGS or
#                  ELIXIR_ERL_OPTIONS sets +MIscs, so the share is always of
#                  the default region. Prints the peak and its share
#                                                       (after gleam-test)
#   code-rules     fast mode only: gleam test -- --tag code_rule, the tests of
#                  test/code_rule, each tagged with unitest.tag("code_rule")
#                  (`./check fast` has its own budget, GENESIS_CHECK_FAST_BUDGET_SECONDS)
#                                                       (after gleam-build)
#   message-codec  gleam run -m genesis_prime/generate_messages -- check
#                  the committed message codec equals what the schema
#                  generates                            (after gleam-build)
#   migrations     a fresh database with a unique name, every
#                  priv/migrations/*.sql applied in name order and recorded in
#                  schema_migration by dev/apply_migrations.sh, each file and
#                  its record in one psql --single-transaction
#   squirrel       gleam run -m squirrel check, against that database
#   client-suite   the client scripts' tests that need no Ghidra (run with
#                  GENESIS_INTEGRATION=0, whatever the caller exported), then the
#                  playing-live scripts' tests
#   client-integration  the client scripts' tests that run the client's code on
#                  Ghidra's emulator (GENESIS_INTEGRATION=1; skipped where
#                  GENESIS_NO_CLIENT=1 and where the branch leaves the client
#                  scripts unchanged)
#   fact-checker   check_facts.py over the fact file
#
# The database is on the Postgres named by PGHOST, PGPORT and PGUSER (defaults
# /tmp, 5433 and postgres: the native Postgres 18 on the development machine)
# and is dropped on exit, also on failure. squirrel connects over TCP only:
# when PGHOST is a socket directory, it uses PGTCPHOST (default ::1).
#
# GENESIS_NO_CLIENT=1, which only CI sets, marks a machine without the client;
# everywhere else a missing client fails the part that reads it. It does not
# turn off the patched OTP: CI sets GENESIS_OTP_DIR to the build it caches.
#
# gleam holds a lock on its build directory, so the gleam parts run one after
# another in a single chain; every other part runs beside the chain.

cd "$(dirname "${BASH_SOURCE[0]}")" || exit 1

# The clock starts here, before the setup check.
started=$(date +%s)

mode=${1:-full}
case "$mode" in
  full | fast) ;;
  *)
    echo "usage: ./check [fast]"
    exit 2
    ;;
esac

# The wall time the check may take, in seconds.
budget=${GENESIS_CHECK_BUDGET_SECONDS:-120}

# The same for ./check fast, from a cold build: measured right after removing
# build/dev/erlang/genesis_prime, 10, 9 and 9 s in 3 runs on
# the development Mac (warm: 6, 7 and 7 s); 10 s times 1.25, rounded up.
if [ "$mode" = fast ]; then
  budget=${GENESIS_CHECK_FAST_BUDGET_SECONDS:-13}
fi

# The budget of a run that includes the integration tests: the slowest of 3
# solo runs on the development Mac was 466 s, times
# 1.25, rounded up.
integration_budget=${GENESIS_CHECK_INTEGRATION_BUDGET_SECONDS:-583}

client_scripts=.claude/skills/decoding-the-client/scripts

# How many module groups `gleam test` runs at once; each also runs up to one test
# per scheduler at once. 1 is the smallest count that leaves 25% of the 120 s
# budget spare: measured, the whole check took 75 s with 1
# (gleam-test 68 s with the serial tests, beside the setup suite) and 62 to 67 s
# with 2; `gleam test -- --workers 1` alone took 58 to 75 s in 16 runs on the
# development Mac (12 schedulers) and 67 s with 4 schedulers (ERL_FLAGS="+S 4:4",
# CI's 4 cores), against 119 s with one test at a time.
test_workers=${GENESIS_TEST_WORKERS:-1}

# The literal region of the test VM, in bytes: literal_alloc's super carrier, 1024
# MiB unless +MIscs says otherwise (the check refuses that). A new carrier needs
# one free stretch of it, and a fill test in a fresh VM stopped at 97% of it, so
# a run that nears the region dies partway with `literal_alloc: Cannot allocate`:
# main did, at 99.3% (1,066,336,256 bytes), holding 1.0 GiB of live terms (the
# client's 384 tables 587 MiB, the server's 36 of them again 306 MiB, leaked
# planted loads 70 MiB and growing). With each table held once and no test
# leaving terms, what comes and goes above the live terms is the erased terms
# waiting for the VM to release them (one round over all processes per erased
# term, taking seconds when a dozen tests end together) and the loads in flight.
# A test's load starts only when the allocator holds at most 32 MB beyond the
# live terms, and a test holds one of two places among the loads from its first
# key to its end (test/owned_key.gleam). That bounds the erased terms waiting for
# release and the planted loads in flight. It does not bound the loads that take
# no place (the server's own key's content loads and the shared loads made once
# per run), nor the carriers' fragmentation, so the peak stays above the live
# terms by more than the gate's own allowance. The highest carriers of eleven runs
# with one test worker (the default; more workers run more tests at once), on
# eight seeds of the test order, were 74.1% to 78.7% of the region,
# where the same seeds without the gate gave 79.2% to 83.1%, and four workers
# without it fill the region and end the VM. The limit is 85%: it fails at 870
# MiB, 6.3 points above the worst run measured, so a good run does not fail, and
# it leaves 154 MiB free, 1.4
# times the largest table the suite puts (Spline2Node, 115.7 MB), and 123 MiB
# before the 97% where the VM dies. A run over it fails the check, so the margin
# cannot vanish unnoticed again. The limit is not set from outside: +MIscs is
# refused, and a higher limit is a change to this line with the measurement that
# justifies it.
literal_region_bytes=1073741824
literal_limit_percent=85

# The machine's settings (env.sh) and the patched OTP first on PATH, before any part.
. setup_check/environment.sh

: "${PGHOST:=/tmp}"
: "${PGPORT:=5433}"
: "${PGUSER:=postgres}"
export PGHOST PGPORT PGUSER

# The parts of ./check fast, which a full check whose branch is light also runs.
fast_parts="format gleam-build glinter code-rules"

work=$(mktemp -d)
database="genesis_check_$$_${started}"
case "$mode" in
  full) parts="format gleam-build glinter generated-tables gleam-test literal-area message-codec migrations squirrel client-suite client-integration fact-checker" ;;
  fast) parts="$fast_parts" ;;
esac

# The light set: the paths whose change no part beyond the fast parts reads. Each
# entry is "pattern|reason". A pattern is a shell glob in which `**` crosses
# folders; one without `**` matches only a path of its own depth, so `dev/*.sh`
# leaves out dev/genesis_prime/. Whatever the set does not name is not light,
# among it the fact file and the client's scripts (the fact checker and the client
# suite read them), check and setup_check (the setup check's tests), and the
# sources.
light_set=(
  "CLAUDE.md|guidance: the code rules read it, no other part does"
  ".claude/skills/**/*.md|guidance: the code rules read it, no other part does"
  ".claude/agents/**|guidance: the code rules read it, no other part does"
  ".github/workflows/**|CI's workflow: only CI runs it, and CI runs every part"
  "LICENSE|the licence text: no part reads it"
  ".gitignore|which files git skips: no part reads it"
  "dev/*.sh|a shell tool beside the code: no part tests it"
  "dev/*.py|a Python tool beside the code: no part tests it"
)

# The paths the light set's globs would take that are not light, as "path|reason".
light_set_except=(
  "dev/apply_migrations.sh|the migrations part runs it"
)

# slash_count PATH: how many `/` PATH holds.
slash_count() {
  local slashes=${1//[!\/]/}
  echo "${#slashes}"
}

# in_light_set PATH: succeeds when PATH matches an entry of the light set and none
# of light_set_except.
in_light_set() {
  local entry pattern
  for entry in "${light_set_except[@]}"; do
    [ "$1" = "${entry%%|*}" ] && return 1
  done
  for entry in "${light_set[@]}"; do
    pattern=${entry%%|*}
    case "$pattern" in
      *'**'*) pattern=${pattern//'**'/*} ;;
      *) [ "$(slash_count "$1")" = "$(slash_count "$pattern")" ] || continue ;;
    esac
    # shellcheck disable=SC2254 # the pattern is a glob on purpose
    case "$1" in
      $pattern) return 0 ;;
    esac
  done
  return 1
}

# history_is_shallow: succeeds when the repository's history is shallow.
history_is_shallow() {
  [ "$(git rev-parse --is-shallow-repository 2>/dev/null)" = true ]
}

# merge_base: prints the merge base of HEAD with origin/main, or with main when
# there is no origin/main; prints nothing when there is neither.
merge_base() {
  git merge-base HEAD origin/main 2>/dev/null || git merge-base HEAD main 2>/dev/null
}

# changed_files BASE [PATH...]: sets changed_list to the files, one per line, that
# the working tree changes since BASE (committed or not, deleted or renamed ones
# under both names, untracked ones too), limited to the PATHs when there are any.
# Fails, with changed_files_error naming the git command that failed, when git
# cannot say.
changed_files() {
  local base=$1 tracked untracked
  shift
  if ! tracked=$(git -c core.quotePath=false diff --name-only --no-renames "$base" -- "$@" 2>&1); then
    changed_files_error="git diff failed (${tracked%%$'\n'*})"
    return 1
  fi
  if ! untracked=$(git -c core.quotePath=false ls-files --others --exclude-standard -- "$@" 2>&1); then
    changed_files_error="git ls-files failed (${untracked%%$'\n'*})"
    return 1
  fi
  changed_list=$(printf '%s\n%s\n' "$tracked" "$untracked" | sed '/^$/d')
}

# decide_scope: sets scope to light or full, and scope_why to the reason, from the
# files the branch changes since its merge base with main: light only when there
# is at least one and every one is in the light set. It is full on CI's machine,
# whose checkout is shallow anyway (GENESIS_NO_CLIENT=1, which only CI sets, or
# GITHUB_ACTIONS), and wherever the changed files are not known: no merge base, a
# shallow history, or a git command that failed.
decide_scope() {
  local base path count=0 first=""
  scope=full
  if [ "${GENESIS_NO_CLIENT:-}" = 1 ] || [ -n "${GITHUB_ACTIONS:-}" ]; then
    scope_why="this is CI's machine (GENESIS_NO_CLIENT=1 or GITHUB_ACTIONS is set), which runs every part"
    return
  fi
  if history_is_shallow; then
    scope_why="the history is shallow, so the merge base with main cannot be established"
    return
  fi
  base=$(merge_base)
  if [ -z "$base" ]; then
    scope_why="there is no merge base with origin/main or main to find the changed files from"
    return
  fi
  if ! changed_files "$base"; then
    scope_why="$changed_files_error, so the files the branch changes are not known"
    return
  fi
  if [ -z "$changed_list" ]; then
    scope_why="the branch changes no file since its merge base with main"
    return
  fi
  while IFS= read -r path; do
    if ! in_light_set "$path"; then
      scope_why="the branch changes $path since its merge base with main, which is not in the light set"
      return
    fi
    count=$((count + 1))
    [ -n "$first" ] || first=$path
  done <<<"$changed_list"
  scope=light
  scope_why="the $count files the branch changes since its merge base with main (first: $first) are all guidance or tools that no other part reads"
}

# decide_integration: sets integration_run to yes or no, and integration_why to
# the reason, from the machine (GENESIS_NO_CLIENT) and from what the branch
# changed under the client scripts folder since its merge base with main.
decide_integration() {
  local base changed
  if [ "${GENESIS_NO_CLIENT:-}" = 1 ]; then
    integration_run=no
    integration_why="GENESIS_NO_CLIENT=1: there is no client on this machine"
    return
  fi
  base=$(merge_base)
  if [ -z "$base" ]; then
    integration_run=yes
    integration_why="there is no merge base with origin/main or main to compare the client scripts with"
    return
  fi
  if ! changed_files "$base" "$client_scripts"; then
    integration_run=yes
    integration_why="$changed_files_error, so the changes under $client_scripts are not known"
    return
  fi
  changed=$(printf '%s\n' "$changed_list" | head -n 1)
  if [ -n "$changed" ]; then
    integration_run=yes
    integration_why="the branch changes $changed under $client_scripts since its merge base with main"
  else
    integration_run=no
    integration_why="unchanged: the branch changes nothing under $client_scripts since its merge base with main"
  fi
}

# skip NAME REASON: records that the part did not run on purpose, and why.
skip() {
  echo "$2" >"$work/$1.skipped"
}

# descendants_of PID: the process ids of everything PID started, children,
# their children and so on, from one snapshot of the process table.
descendants_of() {
  ps -A -o pid= -o ppid= | awk -v root="$1" '
    { parent[$1] = $2 }
    END {
      for (p in parent) {
        q = p
        while ((q in parent) && q != root && q != 0 && q != 1) q = parent[q]
        if (q == root && p != root) print p
      }
    }'
}

# stop_everything PID: ends everything PID started: asks first, then kills what
# is still there, twice, for what was started in between.
stop_everything() {
  local pids
  pids=$(descendants_of "$1")
  [ -n "$pids" ] && kill -TERM $pids 2>/dev/null
  sleep 1
  for _ in 1 2; do
    pids=$(descendants_of "$1")
    [ -n "$pids" ] && kill -KILL $pids 2>/dev/null
  done
  return 0
}

# The hang limit is three times the budget: a watchdog sends this shell USR1 when
# it is reached, and the handler ends everything the check started, so a part or a
# setup check that hangs cannot hold the check for ever.
hung=no
on_hung() {
  hung=yes
  stop_everything $$
}
trap on_hung USR1

# stop_everything_quickly PID: kills PID and everything it started, at once.
stop_everything_quickly() {
  local pids
  pids=$(descendants_of "$1")
  kill -KILL $1 $pids 2>/dev/null
  return 0
}

# drop_database: drops the check's database, for at most 3 seconds: Postgres may
# have stopped answering, and the deadline that ended the check is already spent.
drop_database() {
  local pid waited=0
  PGCONNECT_TIMEOUT=3 psql -X -q -d postgres -c "drop database if exists \"$database\" with (force)" \
    >/dev/null 2>&1 &
  pid=$!
  while kill -0 "$pid" 2>/dev/null && [ "$waited" -lt 30 ]; do
    sleep 0.1
    waited=$((waited + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    stop_everything_quickly "$pid"
  fi
  return 0
}

cleanup() {
  if [ -f "$work/database_created" ]; then
    drop_database
  fi
  [ -n "${watchdog:-}" ] && stop_everything_quickly "$watchdog"
  rm -rf "$work"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

# branch_current: the first part of the full check. Prints one line, and ends the
# check when HEAD lacks commits of origin/main as last fetched.
branch_current() {
  local behind tip noun=commits
  if ! tip=$(git rev-parse --short --verify --quiet origin/main 2>/dev/null); then
    printf '  %-18s skipped (there is no origin/main to compare with)\n' branch-current
    return
  fi
  if history_is_shallow; then
    printf '  %-18s skipped (the history is shallow, so whether HEAD holds origin/main cannot be established)\n' branch-current
    return
  fi
  if ! behind=$(git rev-list --count HEAD..origin/main); then
    echo "check FAILED: branch-current: git could not count the commits of origin/main that HEAD lacks, so no other part ran"
    exit 1
  fi
  if [ "$behind" = 0 ]; then
    printf '  %-18s ok      HEAD holds origin/main (tip %s)\n' branch-current "$tip"
    return
  fi
  [ "$behind" = 1 ] && noun=commit
  echo "check FAILED: branch-current: HEAD lacks $behind $noun of origin/main (tip $tip): merge origin/main first, so no other part ran"
  exit 1
}

if [ "$mode" = full ]; then
  branch_current
  decide_scope
  if [ "$scope" = light ]; then
    mode=fast
    parts=$fast_parts
    scope_label=" (scope: light)"
    budget=${GENESIS_CHECK_FAST_BUDGET_SECONDS:-13}
    echo "scope: light, so only the fast parts run ($fast_parts): $scope_why; CI runs every part"
  else
    echo "scope: every part, because $scope_why"
  fi
fi

if [ "$mode" = full ]; then
  decide_integration
  if [ "$integration_run" = yes ]; then
    if [ "$integration_budget" -gt "$budget" ]; then
      budget=$integration_budget
    fi
    echo "budget raised to ${budget}s: the client's integration tests run, because $integration_why"
  else
    skip client-integration "$integration_why"
  fi
fi

# The watchdog: USR1 to this shell when the hang limit is reached.
hang_limit=$((3 * budget))
(
  remaining=$((started + hang_limit - $(date +%s)))
  [ "$remaining" -gt 0 ] || remaining=0
  sleep "$remaining"
  kill -USR1 $$ 2>/dev/null
) &
watchdog=$!

# The setup check comes first: when it fails, nothing else runs. It runs in the
# background and is waited for, so the deadline can end it.
./setup-check &
wait $!
setup_status=$?
if [ "$hung" = yes ]; then
  echo
  echo "check FAILED: the setup check hung, still running at three times its budget of ${budget}s"
  echo "wall time $(($(date +%s) - started))s, budget ${budget}s"
  exit 1
fi
if [ "$setup_status" != 0 ]; then
  echo
  echo "check FAILED: the setup check failed, so no other part ran"
  exit 1
fi


# step NAME COMMAND...: runs the command here, its output to a log, and records
# its status and seconds under NAME; a part with a started record and no status
# was running when the check stopped.
step() {
  local name=$1 status begin
  shift
  begin=$(date +%s)
  touch "$work/$name.started"
  "$@" >"$work/$name.log" 2>&1
  status=$?
  echo "$status" >"$work/$name.status"
  echo $(($(date +%s) - begin)) >"$work/$name.seconds"
  return $status
}

# in_background COMMAND...: runs the command in the background, and remembers its
# process id, so the check waits for the parts and not for the watchdog.
part_pids=()
in_background() {
  ("$@") &
  part_pids+=("$!")
}

prepare_database() {
  psql -X -q -v ON_ERROR_STOP=1 -d postgres -c "create database \"$database\"" || return 1
  touch "$work/database_created"
  dev/apply_migrations.sh "$database"
}

database_url() {
  local host=$PGHOST
  case "$host" in
    /*) host=${PGTCPHOST:-::1} ;;
  esac
  case "$host" in
    *:*) host="[$host]" ;;
  esac
  local login=$PGUSER
  if [ -n "${PGPASSWORD:-}" ]; then
    login="$PGUSER:$PGPASSWORD"
  fi
  echo "postgres://$login@$host:$PGPORT/$database"
}

# wait_for_status NAME: waits until the part NAME has written its status, and
# succeeds when it is 0. It has no limit of its own: the hang limit stops the
# whole check, so a part that needs it is skipped only when it really failed.
wait_for_status() {
  local name=$1
  while [ ! -f "$work/$name.status" ]; do
    sleep 0.2
  done
  [ "$(cat "$work/$name.status" 2>/dev/null)" = 0 ]
}

# The tests tagged serial share a machine-wide resource (a child node's epmd and
# ports), so they run one at a time, in a second run; the first run skips them
# (GENESIS_TEST_SKIP_SERIAL, read by test/genesis_prime_test.gleam).
#
# The first run also keeps the literal allocator's highest carriers size in
# $work/literal-peak (GENESIS_LITERAL_PEAK_FILE, read by test/genesis_prime_test.gleam),
# which the literal-area part compares with its limit. The serial run is left
# out: it runs a few tests alone, in a VM of its own.
gleam_test() {
  local status=0
  if [ -n "$test_workers" ]; then
    GENESIS_LITERAL_PEAK_FILE="$work/literal-peak" GENESIS_TEST_SKIP_SERIAL=1 \
      gleam test -- --workers "$test_workers" || status=1
  else
    GENESIS_LITERAL_PEAK_FILE="$work/literal-peak" GENESIS_TEST_SKIP_SERIAL=1 \
      gleam test || status=1
  fi
  gleam test -- --tag serial || status=1
  return $status
}

# literal_area_check: fails when the first test run's highest carriers size is
# over literal_limit_percent of the region, or when there is none to compare. The
# first line it prints is the measure, which the check prints under the parts.
literal_area_check() {
  local peak
  case "${ERL_FLAGS:-} ${ERL_AFLAGS:-} ${ERL_ZFLAGS:-} ${ELIXIR_ERL_OPTIONS:-}" in
    *+MIscs*)
      echo "ERL_FLAGS, ERL_AFLAGS, ERL_ZFLAGS or ELIXIR_ERL_OPTIONS sets +MIscs: the limit is a share of the default 1 GiB literal region, so the region is not to be changed; unset it"
      return 1
      ;;
  esac
  peak=$(cat "$work/literal-peak" 2>/dev/null)
  case "$peak" in
    '' | *[!0-9]*)
      echo "the test run wrote no literal area peak to $work/literal-peak, so the area's margin was not measured"
      return 1
      ;;
  esac
  echo "literal area: peak $((peak / 1048576)) MiB of $((literal_region_bytes / 1048576)) MiB ($((peak * 1000 / literal_region_bytes / 10)).$((peak * 1000 / literal_region_bytes % 10))%), limit ${literal_limit_percent}%"
  if [ $((peak * 100)) -gt $((literal_region_bytes * literal_limit_percent)) ]; then
    echo "over the limit of ${literal_limit_percent}% of the region: a test run that holds more persistent terms than that dies with literal_alloc when one more is put (see the limit's reason in ./check); find what holds them before raising it"
    return 1
  fi
}

# The client scripts' tests that need no Ghidra, then the playing-live scripts' tests.
client_suite() {
  env GENESIS_INTEGRATION=0 python3.13 -I -m unittest discover -s "$client_scripts" -p 'test_*.py' &&
    python3.13 -I -m unittest discover -s .claude/skills/playing-live/scripts -p 'test_*.py'
}

# The client scripts' integration tests: their own tests with
# GENESIS_INTEGRATION=1, which opens the gate of check_support.integration_only.
client_integration() {
  GENESIS_INTEGRATION=1 python3.13 -I -m unittest discover -s "$client_scripts" -p 'test_*.py'
}

squirrel_check() {
  DATABASE_URL=$(database_url) gleam run -m squirrel check
}

gleam_chain() {
  if step gleam-build gleam build --warnings-as-errors; then
    step glinter gleam run -m glinter
    step generated-tables gleam run -m genesis_prime/table_generator check
    step gleam-test gleam_test
    step literal-area literal_area_check
    step message-codec gleam run -m genesis_prime/generate_messages -- check
  else
    skip glinter "a part it needs failed: gleam-build"
    skip generated-tables "a part it needs failed: gleam-build"
    skip gleam-test "a part it needs failed: gleam-build"
    skip literal-area "a part it needs failed: gleam-build"
    skip message-codec "a part it needs failed: gleam-build"
  fi
  if wait_for_status migrations; then
    step squirrel squirrel_check
  else
    skip squirrel "a part it needs failed: migrations"
  fi
}

fast_chain() {
  if step gleam-build gleam build --warnings-as-errors; then
    step glinter gleam run -m glinter
    step code-rules gleam test -- --tag code_rule
  else
    skip glinter "a part it needs failed: gleam-build"
    skip code-rules "a part it needs failed: gleam-build"
  fi
}

facts_with_the_client_named() {
  if [ "${GENESIS_NO_CLIENT:-}" != 1 ] && [ -z "${WILDSTAR_CLIENT_EXE:-}" ]; then
    WILDSTAR_CLIENT_EXE=$(python3.13 -I -c '
import sys
sys.path.insert(0, ".claude/skills/decoding-the-client/scripts")
import check_support
print(check_support.client_exe())')
    export WILDSTAR_CLIENT_EXE
  fi
  python3.13 -I .claude/skills/decoding-the-client/scripts/check_facts.py 2>&1 |
    tee "$work/facts.out"
  local status=${PIPESTATUS[0]}
  if [ "${GENESIS_NO_CLIENT:-}" != 1 ] && grep -q "name rule was not checked" "$work/facts.out"; then
    echo "the client is missing and GENESIS_NO_CLIENT is not 1, so the name rule did not run"
    return 1
  fi
  return "$status"
}

in_background step format gleam format --check src test dev
case "$mode" in
  full)
    in_background gleam_chain
    in_background step migrations prepare_database
    in_background step client-suite client_suite
    if [ "$integration_run" = yes ]; then
      in_background step client-integration client_integration
    fi
    in_background step fact-checker facts_with_the_client_named
    ;;
  fast)
    in_background fast_chain
    ;;
esac
wait "${part_pids[@]}"

failed=""
failed_names=""
hung_names=""
for part in $parts; do
  if [ -f "$work/$part.skipped" ]; then
    printf '  %-18s skipped (%s)\n' "$part" "$(cat "$work/$part.skipped")"
  elif [ ! -f "$work/$part.status" ]; then
    failed="$failed $part"
    if [ "$hung" = yes ] && [ -f "$work/$part.started" ]; then
      printf '  %-18s FAILED  hung: still running at three times its budget\n' "$part"
      hung_names="${hung_names:+$hung_names, }$part"
      continue
    elif [ "$hung" = yes ]; then
      printf '  %-18s FAILED  never started: the check was stopped as hung\n' "$part"
    else
      printf '  %-18s FAILED  never wrote its status\n' "$part"
    fi
    failed_names="${failed_names:+$failed_names, }$part"
  elif [ "$(cat "$work/$part.status")" = 0 ]; then
    printf '  %-18s ok      %ss\n' "$part" "$(cat "$work/$part.seconds")"
  else
    printf '  %-18s FAILED  %ss\n' "$part" "$(cat "$work/$part.seconds")"
    failed="$failed $part"
    failed_names="${failed_names:+$failed_names, }$part"
  fi
done

if [ -f "$work/gleam-test.log" ]; then
  seeds=$(grep -h '^Seed: ' "$work/gleam-test.log" | sed 's/^Seed: //' | tr '\n' ' ' | sed 's/ $//')
  [ -n "$seeds" ] && echo "  gleam-test seeds: $seeds"
fi

if [ -f "$work/literal-area.log" ]; then
  measure=$(grep -h '^literal area: ' "$work/literal-area.log" | head -n 1)
  [ -n "$measure" ] && echo "  $measure"
fi

for part in $failed; do
  echo
  echo "---- $part ----"
  if [ -f "$work/$part.log" ]; then
    cat "$work/$part.log"
  else
    echo "(the part wrote no status and no log)"
  fi
done

elapsed=$(($(date +%s) - started))
echo
if [ "$hung" = no ] && [ "$elapsed" -gt "$budget" ]; then
  echo "check WARNING: over its budget, wall time ${elapsed}s, budget ${budget}s"
fi
if [ -n "$failed" ] || [ "$hung" = yes ]; then
  reasons=$failed_names
  if [ "$hung" = yes ]; then
    reasons="${reasons:+$reasons; }${hung_names:-the check} hung, still running at three times its budget of ${budget}s"
  fi
  echo "check FAILED: $reasons"
  echo "wall time ${elapsed}s, budget ${budget}s"
  exit 1
fi
echo "check passed${scope_label:-}, wall time ${elapsed}s, budget ${budget}s"
