fn row_id(row: ModelMesh) -> Int {
  row.id
}

fn decode_record(
  record record: BitArray,
  strings strings: tbl_file.Strings,
) -> Result(ModelMesh, tbl_file.RecordError) {
  case record {
    <<c0:size(32)-little-signed, _:size(32), c1:size(64)-little, _:bits>> -> {
      use c1 <- result.try(tbl_file.text(strings, c1, "EnumName"))
      Ok(ModelMesh(id: c0, enum_name: c1))
    }
    _ -> Error(tbl_file.NotARecord)
  }
}
