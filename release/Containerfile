# The play server's image, built from a clean checkout of main by
# dev/play_service/update.sh:
#
#   git archive <sha> | tar -x -C <context>
#   podman build --build-arg REVISION=<sha> -t genesis-play:<sha> \
#     -f release/Containerfile <context>
#
# Two stages, each a layer the next build reuses while its inputs stand:
#   build    gleam and rebar3, the dependencies, then release/build
#   runtime  the shipment, psql and the migration script
#
# Both stages start from the official Erlang image of the OTP version in
# .tool-versions, pinned by digest (ERLANG below; the build stage refuses an image
# whose OTP version is not the one .tool-versions names). The gleam and rebar3 programs are public release assets fetched
# by release/fetch_release.sh, which checks their digests; the build holds no GitHub
# login. The image holds none
# of the client's files, no table, no ground file and no secret: the client's tables are
# mounted at /tables, the ground files at /terrain, the recordings at /sittings, and the database's address and
# password and the game address come in as environment variables when the
# container starts.

ARG ERLANG=docker.io/library/erlang:29.1.3-slim@sha256:548fb8fa9e0d627a1c58e398e949d68c46465f766ee5eac3ea406a861764f072

FROM ${ERLANG} AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl jq libncurses-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*
ENV PATH=/opt/tools:$PATH
WORKDIR /repository
COPY .tool-versions ./
RUN set -eu; \
    pinned=$(awk '$1 == "erlang" { print $2 }' .tool-versions); \
    found=$(erl -noshell -eval '{ok, V} = file:read_file(filename:join([code:root_dir(), "releases", erlang:system_info(otp_release), "OTP_VERSION"])), io:format("~s", [string:trim(V)]), halt().'); \
    [ "$found" = "$pinned" ] || { echo "the base image holds OTP $found, .tool-versions names $pinned" >&2; exit 1; }
COPY setup_check/sha256.sh setup_check/
COPY release/fetch_release.sh release/
RUN set -eu; \
    mkdir -p /opt/tools /tmp/fetched; \
    gleam=$(awk '$1 == "gleam" { print $2 }' .tool-versions); \
    rebar=$(awk '$1 == "rebar" { print $2 }' .tool-versions); \
    asset=gleam-v$gleam-$(uname -m)-unknown-linux-musl.tar.gz; \
    release/fetch_release.sh gleam-lang/gleam "v$gleam" "$asset" /tmp/fetched; \
    tar -xzf "/tmp/fetched/$asset" -C /opt/tools; \
    release/fetch_release.sh erlang/rebar3 "$rebar" rebar3 /tmp/fetched; \
    install -m 0755 /tmp/fetched/rebar3 /opt/tools/rebar3; \
    rm -rf /tmp/fetched
COPY gleam.toml manifest.toml ./
RUN gleam deps download
COPY src src
COPY priv priv
COPY release release
RUN release/build

FROM ${ERLANG} AS runtime
ARG REVISION=unknown
RUN apt-get update && apt-get install -y --no-install-recommends \
      bash ca-certificates postgresql-client \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /repository/build/erlang-shipment /app
COPY release/container_start /app/container_start
COPY dev/apply_migrations.sh /migrate/dev/apply_migrations.sh
COPY setup_check/sha256.sh /migrate/setup_check/sha256.sh
COPY priv/migrations /migrate/priv/migrations
RUN ! find / -xdev -type f \( -name '*.tbl' -o -name '*.heights' \) | grep -q .
ENV GENESIS_TABLE_DIR=/tables \
    GENESIS_TERRAIN_DIR=/terrain \
    GENESIS_REVISION=$REVISION
LABEL genesis.revision=$REVISION
ENTRYPOINT ["/app/container_start"]
