fn decode_record(
  record record: BitArray,
  strings strings: tbl_file.Strings,
) -> Result(WorldSky, tbl_file.RecordError) {
  case record {
    <<
      c0:size(32)-little-signed,
      _:size(32),
      c1:size(64)-little,
      c2:size(64)-little,
      c3:size(32)-little-signed,
      _:bits,
    >> -> {
      use c1 <- result.try(tbl_file.text(strings, c1, "assetPath"))
      use c2 <- result.try(tbl_file.text(strings, c2, "assetPathInFlux"))
