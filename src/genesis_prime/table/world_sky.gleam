pub const schema =
  tbl_file.Schema(
    table: "WorldSky",
    file: "WorldSky",
    record_size: 32,
    columns: [
      tbl_file.Column(name: "ID", column_type: tbl_file.Integer32),
      tbl_file.Column(name: "assetPath", column_type: tbl_file.Utf16Text),
      tbl_file.Column(name: "assetPathInFlux", column_type: tbl_file.Utf16Text),
