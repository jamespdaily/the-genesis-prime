//// Generated by `gleam run -m genesis_prime/table_generator` from the client's DB/SoundBank.tbl.
//// The client's SoundBank table: its row type, its schema and the decoder
//// of its records. The layout is the client's (game_table.file, game_table.schema
//// and game_table.column_type in the fact file); the table loads only when its
//// file's header equals `schema`.

import genesis_prime/table/loader/store
import genesis_prime/table/loader/tbl_file
import gleam/result

/// One row of the client's SoundBank table.
pub type SoundBank {
  SoundBank(id: Int, name: String)
}

/// The layout of the client's SoundBank table: its name, record size and
/// columns, which a file must equal to be loaded.
pub const schema =
  tbl_file.Schema(
    table: "SoundBank",
    file: "SoundBank",
    record_size: 16,
    columns: [
      tbl_file.Column(name: "id", column_type: tbl_file.Integer32),
      tbl_file.Column(name: "name", column_type: tbl_file.Utf16Text),
    ],
  )

/// The entry that loads the SoundBank table.
pub fn entry() -> store.Entry {
  store.entry(schema:, decode: decode_record, id: row_id)
}

/// The row of the SoundBank table with the id, or an error when it has none.
pub fn get(tables tables: store.Tables, id id: Int) -> Result(SoundBank, Nil) {
  store.row(tables, schema.table, id)
}

/// Every row of the SoundBank table, in id order.
pub fn all(tables: store.Tables) -> List(SoundBank) {
  store.rows(tables, schema.table)
}

fn row_id(row: SoundBank) -> Int {
  row.id
}

fn decode_record(
  record record: BitArray,
  strings strings: tbl_file.Strings,
) -> Result(SoundBank, tbl_file.RecordError) {
  case record {
    <<c0:size(32)-little-signed, _:size(32), c1:size(64)-little, _:bits>> -> {
      use c1 <- result.try(tbl_file.text(strings, c1, "name"))
      Ok(SoundBank(id: c0, name: c1))
    }
    _ -> Error(tbl_file.NotARecord)
  }
}
