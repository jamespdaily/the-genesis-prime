//// Generated by `gleam run -m genesis_prime/table_generator` from the client's DB/Wind.tbl.
//// The client's Wind table: its row type, its schema and the decoder
//// of its records. The layout is the client's (game_table.file, game_table.schema
//// and game_table.column_type in the fact file); the table loads only when its
//// file's header equals `schema`.
//// Rows keep plain `Int` ids: typed ids in the client's 26,362,088 id cells would add about 603 MB (measured); `get` and the readers give the typed ids of `genesis_prime/table/id`.

import genesis_prime/table/id.{type WindId, WindId}
import genesis_prime/table/loader/store
import genesis_prime/table/loader/tbl_file

/// One row of the client's Wind table.
pub type Wind {
  Wind(
    id: Int,
    type_: Int,
    duration: Int,
    radius_end: Float,
    direction: Float,
    direction_delta: Float,
    blend_in: Float,
    blend_out: Float,
    speed: Float,
    sine2_d_magnitude_min: Float,
    sine2_d_magnitude_max: Float,
    sine2_d_frequency: Float,
    sine2_d_offset_angle: Float,
    local_radial: Int,
    local_magnitude: Float,
  )
}

/// The layout of the client's Wind table: its name, record size and
/// columns, which a file must equal to be loaded.
pub const schema =
  tbl_file.Schema(
    table: "Wind",
    file: "Wind",
    record_size: 60,
    columns: [
      tbl_file.Column(name: "ID", column_type: tbl_file.Integer32),
      tbl_file.Column(name: "type", column_type: tbl_file.Integer32),
      tbl_file.Column(name: "duration", column_type: tbl_file.Integer32),
      tbl_file.Column(name: "radiusEnd", column_type: tbl_file.Float32),
      tbl_file.Column(name: "direction", column_type: tbl_file.Float32),
      tbl_file.Column(name: "directionDelta", column_type: tbl_file.Float32),
      tbl_file.Column(name: "blendIn", column_type: tbl_file.Float32),
      tbl_file.Column(name: "blendOut", column_type: tbl_file.Float32),
      tbl_file.Column(name: "speed", column_type: tbl_file.Float32),
      tbl_file.Column(name: "sine2DMagnitudeMin", column_type: tbl_file.Float32),
      tbl_file.Column(name: "sine2DMagnitudeMax", column_type: tbl_file.Float32),
      tbl_file.Column(name: "sine2DFrequency", column_type: tbl_file.Float32),
      tbl_file.Column(name: "sine2DOffsetAngle", column_type: tbl_file.Float32),
      tbl_file.Column(name: "localRadial", column_type: tbl_file.Integer32),
      tbl_file.Column(name: "localMagnitude", column_type: tbl_file.Float32),
    ],
  )

/// The entry that loads the Wind table.
pub fn entry() -> store.Entry {
  store.entry(schema:, decode: decode_record, id: row_id)
}

/// The row of the Wind table with the id, or an error when it has none.
pub fn get(tables tables: store.Tables, id id: WindId) -> Result(Wind, Nil) {
  store.row(tables, schema.table, id.value)
}

/// Every row of the Wind table, in id order.
pub fn all(tables: store.Tables) -> List(Wind) {
  store.rows(tables, schema.table)
}

/// The row's own id, as the typed id of its table.
pub fn id(row: Wind) -> WindId {
  WindId(row.id)
}

fn row_id(row: Wind) -> Int {
  row.id
}

fn decode_record(
  record record: BitArray,
  strings _strings: tbl_file.Strings,
) -> Result(Wind, tbl_file.RecordError) {
  case record {
    <<
      c0:size(32)-little-signed,
      c1:size(32)-little-signed,
      c2:size(32)-little-signed,
      c3:size(32)-little-float,
      c4:size(32)-little-float,
      c5:size(32)-little-float,
      c6:size(32)-little-float,
      c7:size(32)-little-float,
      c8:size(32)-little-float,
      c9:size(32)-little-float,
      c10:size(32)-little-float,
      c11:size(32)-little-float,
      c12:size(32)-little-float,
      c13:size(32)-little-signed,
      c14:size(32)-little-float,
      _:bits,
    >> -> {
      Ok(Wind(
        id: c0,
        type_: c1,
        duration: c2,
        radius_end: c3,
        direction: c4,
        direction_delta: c5,
        blend_in: c6,
        blend_out: c7,
        speed: c8,
        sine2_d_magnitude_min: c9,
        sine2_d_magnitude_max: c10,
        sine2_d_frequency: c11,
        sine2_d_offset_angle: c12,
        local_radial: c13,
        local_magnitude: c14,
      ))
    }
    _ -> Error(tbl_file.NotARecord)
  }
}
