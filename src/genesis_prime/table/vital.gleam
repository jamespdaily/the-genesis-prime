//// Generated by `gleam run -m genesis_prime/table_generator` from the client's DB/Vital.tbl.
//// The client's Vital table: its row type, its schema and the decoder
//// of its records. The layout is the client's (game_table.file, game_table.schema
//// and game_table.column_type in the fact file); the table loads only when its
//// file's header equals `schema`.

import genesis_prime/table/loader/store
import genesis_prime/table/loader/tbl_file

/// One row of the client's Vital table.
pub type Vital {
  Vital(id: Int, localized_text_id_display_text: Int)
}

/// The layout of the client's Vital table: its name, record size and
/// columns, which a file must equal to be loaded.
pub const schema =
  tbl_file.Schema(
    table: "Vital",
    file: "Vital",
    record_size: 8,
    columns: [
      tbl_file.Column(name: "ID", column_type: tbl_file.Integer32),
      tbl_file.Column(
        name: "localizedTextIdDisplayText",
        column_type: tbl_file.Integer32,
      ),
    ],
  )

/// The entry that loads the Vital table.
pub fn entry() -> store.Entry {
  store.entry(schema:, decode: decode_record, id: row_id)
}

/// The row of the Vital table with the id, or an error when it has none.
pub fn get(tables tables: store.Tables, id id: Int) -> Result(Vital, Nil) {
  store.row(tables, schema.table, id)
}

/// Every row of the Vital table, in id order.
pub fn all(tables: store.Tables) -> List(Vital) {
  store.rows(tables, schema.table)
}

fn row_id(row: Vital) -> Int {
  row.id
}

fn decode_record(
  record record: BitArray,
  strings _strings: tbl_file.Strings,
) -> Result(Vital, tbl_file.RecordError) {
  case record {
    <<c0:size(32)-little-signed, c1:size(32)-little-signed, _:bits>> -> {
      Ok(Vital(id: c0, localized_text_id_display_text: c1))
    }
    _ -> Error(tbl_file.NotARecord)
  }
}
