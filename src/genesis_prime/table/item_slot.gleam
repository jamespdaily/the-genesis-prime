//// Generated by `gleam run -m genesis_prime/table_generator` from the client's DB/ItemSlot.tbl.
//// The client's ItemSlot table: its row type, its schema and the decoder
//// of its records. The layout is the client's (game_table.file, game_table.schema
//// and game_table.column_type in the fact file); the table loads only when its
//// file's header equals `schema`.

import genesis_prime/table/loader/store
import genesis_prime/table/loader/tbl_file
import gleam/result

/// One row of the client's ItemSlot table.
pub type ItemSlot {
  ItemSlot(
    id: Int,
    enum_name: String,
    equipped_slot_flags: Int,
    armor_modifier: Float,
    item_level_modifier: Float,
    slot_bonus: Int,
    glyph_slot_bonus: Int,
    min_level: Int,
  )
}

/// The layout of the client's ItemSlot table: its name, record size and
/// columns, which a file must equal to be loaded.
pub const schema =
  tbl_file.Schema(
    table: "ItemSlot",
    file: "ItemSlot",
    record_size: 40,
    columns: [
      tbl_file.Column(name: "ID", column_type: tbl_file.Integer32),
      tbl_file.Column(name: "EnumName", column_type: tbl_file.Utf16Text),
      tbl_file.Column(
        name: "equippedSlotFlags",
        column_type: tbl_file.Integer32,
      ),
      tbl_file.Column(name: "armorModifier", column_type: tbl_file.Float32),
      tbl_file.Column(name: "itemLevelModifier", column_type: tbl_file.Float32),
      tbl_file.Column(name: "slotBonus", column_type: tbl_file.Integer32),
      tbl_file.Column(name: "glyphSlotBonus", column_type: tbl_file.Integer32),
      tbl_file.Column(name: "minLevel", column_type: tbl_file.Integer32),
    ],
  )

/// The entry that loads the ItemSlot table.
pub fn entry() -> store.Entry {
  store.entry(schema:, decode: decode_record, id: row_id)
}

/// The row of the ItemSlot table with the id, or an error when it has none.
pub fn get(tables tables: store.Tables, id id: Int) -> Result(ItemSlot, Nil) {
  store.row(tables, schema.table, id)
}

/// Every row of the ItemSlot table, in id order.
pub fn all(tables: store.Tables) -> List(ItemSlot) {
  store.rows(tables, schema.table)
}

fn row_id(row: ItemSlot) -> Int {
  row.id
}

fn decode_record(
  record record: BitArray,
  strings strings: tbl_file.Strings,
) -> Result(ItemSlot, tbl_file.RecordError) {
  case record {
    <<
      c0:size(32)-little-signed,
      _:size(32),
      c1:size(64)-little,
      c2:size(32)-little-signed,
      c3:size(32)-little-float,
      c4:size(32)-little-float,
      c5:size(32)-little-signed,
      c6:size(32)-little-signed,
      c7:size(32)-little-signed,
      _:bits,
    >> -> {
      use c1 <- result.try(tbl_file.text(strings, c1, "EnumName"))
      Ok(ItemSlot(
        id: c0,
        enum_name: c1,
        equipped_slot_flags: c2,
        armor_modifier: c3,
        item_level_modifier: c4,
        slot_bonus: c5,
        glyph_slot_bonus: c6,
        min_level: c7,
      ))
    }
    _ -> Error(tbl_file.NotARecord)
  }
}
