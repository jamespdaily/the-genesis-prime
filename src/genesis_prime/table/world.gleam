}

fn decode_record(
  record record: BitArray,
  strings strings: tbl_file.Strings,
) -> Result(World, tbl_file.RecordError) {
  case record {
    <<
      c0:size(32)-little-signed,
      _:size(32),
      c1:size(64)-little,
      c2:size(32)-little-signed,
      c3:size(32)-little-signed,
      c4:size(64)-little,
      c5:size(64)-little,
      c6:size(32)-little-signed,
      c7:size(32)-little-signed,
      c8:size(32)-little-signed,
      c9:size(32)-little-signed,
      c10:size(32)-little-signed,
      c11:size(32)-little-signed,
      c12:size(32)-little-signed,
      c13:size(32)-little-signed,
      c14:size(32)-little-signed,
      c15:size(32)-little-signed,
      c16:size(32)-little-signed,
      c17:size(32)-little-signed,
      c18:size(32)-little-signed,
      _:bits,
    >> -> {
      use c1 <- result.try(tbl_file.text(strings, c1, "assetPath"))
      use c4 <- result.try(tbl_file.text(strings, c4, "screenPath"))
      use c5 <- result.try(tbl_file.text(strings, c5, "screenModelPath"))
      Ok(World(
        id: c0,
        asset_path: c1,
        flags: c2,
        type_: c3,
        screen_path: c4,
        screen_model_path: c5,
        chunk_bounds00: c6,
        chunk_bounds01: c7,
        chunk_bounds02: c8,
        chunk_bounds03: c9,
        plug_average_height: c10,
        localized_text_id_name: c11,
        min_item_level: c12,
        max_item_level: c13,
        prime_level_offset: c14,
        prime_level_max: c15,
        veteran_tier_scaling_type: c16,
        heroism_menace_level: c17,
        reward_rotation_content_id: c18,
      ))
    }
    _ -> Error(tbl_file.NotARecord)
  }
}
