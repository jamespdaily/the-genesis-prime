        id: c0,
        max_count: c1,
        flags: c2,
        spell4_id_persistent_buff: c3,
        character_title_id: c4,
        localized_text_id_name: c5,
        localized_text_id_description: c6,
        button_icon: c7,
      ))
    }
    _ -> Error(tbl_file.NotARecord)
  }
