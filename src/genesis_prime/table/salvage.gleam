  Salvage(id: Int, item2_type_id: Int, level: Int)
}

/// The layout of the client's Salvage table: its name, record size and
/// columns, which a file must equal to be loaded.
pub const schema =
  tbl_file.Schema(
    table: "Salvage",
    file: "Salvage",
    record_size: 12,
    columns: [
      tbl_file.Column(name: "ID", column_type: tbl_file.Integer32),
      tbl_file.Column(name: "item2TypeId", column_type: tbl_file.Integer32),
      tbl_file.Column(name: "level", column_type: tbl_file.Integer32),
    ],
  )

/// The entry that loads the Salvage table.
pub fn entry() -> store.Entry {
  store.entry(schema:, decode: decode_record, id: row_id)
}

/// The row of the Salvage table with the id, or an error when it has none.
pub fn get(
  tables tables: store.Tables,
  id id: SalvageId,
) -> Result(Salvage, Nil) {
  store.row(tables, schema.table, id.value)
}

/// Every row of the Salvage table, in id order.
pub fn all(tables: store.Tables) -> List(Salvage) {
  store.rows(tables, schema.table)
}

/// The row's own id, as the typed id of its table.
pub fn id(row: Salvage) -> SalvageId {
  SalvageId(row.id)
}

/// The id in the item2TypeId column, as the typed id of the Item2Type table.
pub fn item2_type_id(row: Salvage) -> Item2TypeId {
  Item2TypeId(row.item2_type_id)
}

fn row_id(row: Salvage) -> Int {
  row.id
}

fn decode_record(
  record record: BitArray,
  strings _strings: tbl_file.Strings,
) -> Result(Salvage, tbl_file.RecordError) {
  case record {
    <<
      c0:size(32)-little-signed,
      c1:size(32)-little-signed,
      c2:size(32)-little-signed,
      _:bits,
    >> -> {
      Ok(Salvage(id: c0, item2_type_id: c1, level: c2))
    }
    _ -> Error(tbl_file.NotARecord)
  }
}
