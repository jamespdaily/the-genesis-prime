pub const schema =
  tbl_file.Schema(
    table: "ModelSequence",
    file: "ModelSequence",
    record_size: 24,
    columns: [
      tbl_file.Column(name: "ID", column_type: tbl_file.Integer32),
      tbl_file.Column(name: "description", column_type: tbl_file.Utf16Text),
      tbl_file.Column(name: "FallBackID", column_type: tbl_file.Integer32),
