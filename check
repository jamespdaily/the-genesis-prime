#!/usr/bin/env bash
# The full check, run locally; CI runs each part of it as a job of its own (.github/workflows/check.yml).
#
# Usage: ./check          every part, the gate before a merge
#        ./check fast     format, gleam-build, glinter, gap-tests, code-rule-tests and
#                         fact-checker only, for the loop while editing and the gate
#                         before a push; the other tests, the registry ones too, run in
#                         the full check's gleam-test part, so in CI, not here
#        ./check part NAME [K/N]
#                         one part of the full check alone (NAME is any part below
#                         but literal-area) with the parts it needs: gleam-build for
#                         each part that starts the built code (for client-suite
#                         only where the client is, since only its client rows test
#                         reads the build), and migrations for squirrel. K/N is for
#                         gleam-test only and required there: the Kth of N shards of
#                         the test modules (below). A bad name or shard prints the
#                         usage and exits 2 before anything runs.
#        ./check scope BASE
#                         whether the files changed since the commit BASE are all in
#                         the light set (below), for CI's pull request run, which asks
#                         it of the merge commit's first parent to choose its legs.
#                         Prints the one `scope:` line the full check prints and exits 0
#                         for a light change and 1 for every other case (no changed
#                         file, a git command that failed, any other file). It reads
#                         CI's machine as an ordinary one, and starts nothing: no setup
#                         check, no part.
#
# A part run starts as the full check does (the watchdog, then the whole setup check,
# which when it fails runs nothing else), decides no scope and runs no branch-current:
# the caller named the part. It prints `scope: part NAME ...`, the summary's row of
# the part and of each part it needs, then the seeds, the `literal area` lines of the
# runs it made (gleam-test K/N its first run, real-tables and world-data their own, no
# other part any), the ten slowest modules, the warnings and `check passed (part NAME),
# wall time Ns, budget Ns`, or `check FAILED: PART` naming what failed. The budget and
# the hang limit are the full check's.
#
# The wall time counts from the start of this script, setup check included. The
# budget is a target: GENESIS_CHECK_BUDGET_SECONDS (default 157; ./check fast has
# its own, GENESIS_CHECK_FAST_BUDGET_SECONDS). A run that ends over its budget passes
# and prints a warning line with its wall time and its budget, because a loaded
# machine (two agents testing at once, a cold build) turns correct code into a
# slow run. Only a hung run fails: one still going at three times its budget has
# everything the check started stopped, and each part that was running is
# reported as hung. A part that ends without writing its status fails the check
# by name.
#
# The full check chooses its scope from the files the branch changes since its
# merge base with origin/main (or main): uncommitted and untracked files count,
# and a deleted or renamed file counts under both of its names. When there is at
# least one and every one is in the light set (light_set below: guidance, the
# licence, .gitignore and the untested shell and Python tools under dev/,
# apply_migrations.sh excepted; the workflow is not light, its own run is what tests
# it), it runs only the parts of ./check fast,
# with ./check fast's budget, prints one `scope: light` line saying why, and ends
# with `check passed (scope: light)`. Every other case runs every part and prints
# a `scope: every part` line with the reason: any other changed file, no changed
# file, no merge base, a shallow history, a failed diff or ls-files, and CI's
# machine (GENESIS_NO_CLIENT=1 or GITHUB_ACTIONS set), whose runs name a part
# or ask `./check scope`. branch-current and the setup check run first in either
# scope.
#
# The full check starts with branch-current: HEAD must hold every commit of
# origin/main as last fetched (git rev-list --count HEAD..origin/main; the check
# fetches nothing). A branch that lacks any fails the check at once, naming how
# many commits and the tip compared and saying to merge origin/main, and no other
# part runs, setup check included. Where there is no origin/main (CI's checkout
# fetches only the merge ref, which holds main by construction) the part is
# skipped and the output says so; so is a shallow history (CI's pushes to main),
# where the count of commits HEAD lacks can include commits it holds.
# ./check fast does not run it.
#
# Then the setup check (./setup-check): it names every part this machine is
# missing, and when it fails nothing else runs. Before it, this script reads
# $GENESIS_HOME/env.sh (default ~/.genesis-prime/env.sh) and puts
# $GENESIS_OTP_DIR/bin first on PATH, unless GENESIS_NO_CLIENT=1 and
# GENESIS_OTP_DIR is unset (setup_check/environment.sh).
#
# Then the parts, independent ones side by side; a part that fails is named, and the
# script exits non-zero:
#   format         gleam format --check src test dev
#   gleam-build    gleam build --warnings-as-errors
#   glinter        glinter, started on the built code    (after gleam-build)
#   generated-tables  genesis_prime/table_generator check, started on the built code
#                  regenerates src/genesis_prime/table* from the client's
#                  game tables in $GENESIS_TABLE_DIR (setup_check/extract_tables.py
#                  fills it) and compares; skipped where GENESIS_NO_CLIENT=1
#                                                       (after gleam-build)
#   gleam-test     the tests, started on the built code, with GENESIS_TEST_WORKERS module groups at
#                  once (default 2; each group also runs its tests at once),
#                  then the tests tagged serial, one at a time; the test tagged
#                  world_data is left to the world-data part, the test tagged
#                  real_start to the real-start part, the tests tagged
#                  real_tables to the real-tables part, the test tagged
#                  client_rows to the client-suite part. A test that returns
#                  after more than half its deadline prints a `check WARNING: test`
#                  line (test/owned_test.gleam), which the summary repeats from this
#                  part's log and the world-data, real-start and real-tables parts';
#                  it never fails the part. Each test is also listed in
#                  $work/gleam-test.running while it runs (GENESIS_TEST_PROGRESS_FILE,
#                  test/test_progress.gleam); the real-start, real-tables, world-data and
#                  client-suite parts' tests are in files of their own. When a hang
#                  stops the check, the summary names under each hung part the tests
#                  that had started and not ended, with the seconds each had run.
#                  A run whose VM dies by any signal (an abort of the VM, 6; a kill for
#                  memory, 9) prints the signal and the same names in its log, and fails the part.
#                  Every VM that runs this project's tests gets `+hmqd off_heap` from one
#                  place, ERL_AFLAGS in setup_check/environment.sh, which this script
#                  sources; the VMs the tests start inherit it. A launcher outside this
#                  script (`gleam test`, dev/repeat_tests.py) runs after
#                  `. setup_check/environment.sh`, as CI's repeat step does;
#                  dev/repeat_tests.py refuses to start without the flag. The release
#                  (release/vm.args) and the load runs' peer name `+hmqd on_heap` themselves.
#                  No tag but serial, world_data, real_start, real_tables and client_rows is
#                  skipped, so the first run also runs the tests tagged code_rule
#                  (the tests of test/code_rule) and registry (each one comparing a
#                  hand-kept list with a registry of the whole server: the tables
#                  the rules read, the messages the codec generates, the messages a
#                  rule names, the spells the client activates); account_store_test,
#                  game_number_test and wire_fixture_test create a database of their
#                  own and need the Postgres of PGHOST, PGPORT, PGUSER and PGPASSWORD
#                  Both runs print unitest's table of each
#                  test's duration (--reporter table), and the summary prints the ten
#                  test modules with the most test time: the sum of the durations of
#                  a module's tests, from both runs. A module's tests run side by
#                  side, so that is the module's test time, not the span it took.
#                  A failed part's log is printed without the table's passed and
#                  skipped rows
#                  `./check part gleam-test K/N` runs shard K of N: unitest has no
#                  shard option, so the run is given a folder (GENESIS_TEST_DIRECTORY,
#                  read by test/genesis_prime_test.gleam) of symlinks, build/chosen_tests/
#                  shard-K-of-N/test, to the .gleam files under test/ the shard owns, at
#                  their own paths below test (support files too: unitest finds a test in
#                  any file). Both runs use it, the first and the serial one. The modules of
#                  heavy_modules (below) are placed first, biggest first, each on the
#                  shard with the least seconds so far (a tie to the lower number); every
#                  other file goes to shard h mod N + 1 with h = (31 * h + byte) mod 1000003
#                  over its path below test without `.gleam`, so a file keeps its shard when
#                  others are added or removed. A shard whose first run ran no test fails
#                  the part; the full check's gleam-test is not sharded.
#                                                       (after gleam-build)
#   real-start     the test tagged real_start, the real server's boot with a bot
#                  playing the opening of the tutorial (most of a minute alone), in a
#                  VM of its own beside gleam-test; skipped where its node cannot run:
#                  GENESIS_NO_CLIENT=1 (the test needs the client's tables)
#                                                       (after gleam-build)
#   real-tables    the tests tagged real_tables, the tests that read the client's whole
#                  tables (several minutes of test time), in a VM of its own beside
#                  gleam-test, which records its literal area peak as the world-data
#                  part does; skipped where GENESIS_NO_CLIENT=1 (the tests need the
#                  client's tables)
#                                                       (after gleam-build)
#   world-data     the tests tagged world_data, the whole world database's
#                  spawn counts, in a VM of its own beside gleam-test (about a
#                  minute alone); skipped where the test cannot run:
#                  GENESIS_NO_CLIENT=1 or GENESIS_WORLD_DATA unset
#                                                       (after gleam-build)
#   literal-area   the test run's room for persistent terms: the highest carriers
#                  size of the literal allocator (the region the VM keeps its
#                  persistent terms in, 1 GiB) that the first test run recorded
#                  (test/literal_area.gleam), against literal_limit_percent of
#                  the region. Never fails: over the limit, when the run recorded
#                  nothing, or when ERL_FLAGS, ERL_AFLAGS, ERL_ZFLAGS or
#                  ELIXIR_ERL_OPTIONS sets +MIscs (the share is of the default
#                  region), it is `ok` and the summary prints a `check WARNING`
#                  line. Prints the peak and its share, for the real-tables and
#                  world-data runs too (each a VM with a region of its own)
#                                                       (after gleam-test, real-tables and world-data)
#   migrations     a fresh database with a unique name, every
#                  priv/migrations/*.sql applied in name order and recorded in
#                  schema_migration by dev/apply_migrations.sh, each file and
#                  its record in one psql --single-transaction
#   squirrel       squirrel check, started on the built code, against that database
#                                                       (after gleam-build and migrations)
#   client-suite   the client scripts' tests that need no Ghidra (run with
#                  GENESIS_INTEGRATION=0, whatever the caller exported), then, except
#                  where GENESIS_NO_CLIENT=1, `client_files.py tokens --check`: the
#                  committed test/fixture/tooltip_tokens/tokens.tsv against the client's
#                  en-US.bin and Spell4.tbl, and the test tagged client_rows, started
#                  on the built code: the committed test/fixture/client_tables against
#                  the client's tables                  (after gleam-build)
#   fact-checker   check_facts.py over the fact file; ./check fast runs it too
#
# ./check fast has two parts more, each the tests of one tag (`gleam test -- --tag TAG`),
# started on the built code after gleam-build, beside glinter: gap-tests, the tests tagged
# gaps, and code-rule-tests, the tests tagged code_rule (the tests of test/code_rule). A test
# that reads a gap registry (`<module>.gaps()` or `gaps.registry()`, itself or through a helper
# of its file) carries the tag gaps, which test/code_rule/gap_test_tag.gleam enforces, so a new
# gap test joins its part on its own; a test of test/code_rule carries the tag code_rule itself.
# The full check does not list them: its gleam-test part runs these tests with the others, so
# `./check part gap-tests` and `./check part code-rule-tests` are refused; nor does a
# light-scope check, whose parts are CI's fast legs.
#
# The database is on the Postgres named by PGHOST, PGPORT and PGUSER (defaults
# /tmp, 5433 and postgres: the native Postgres 18 on the development machine)
# and is dropped on exit, also on failure. squirrel connects over TCP only:
# when PGHOST is a socket directory, it uses PGTCPHOST (default ::1).
#
# GENESIS_NO_CLIENT=1 marks a machine without the client, which is only a CI run
# without the client's data secret (a fork's pull request); everywhere else a missing
# client fails the part that reads it. It does not turn off the patched OTP: CI sets
# GENESIS_OTP_DIR to the build it caches.
#
# gleam-build is the only part that compiles. Every `gleam build`, `gleam run` and
# `gleam test` rewrites each package's .app file, even with nothing changed (gleam
# 1.19.2), and not atomically, so a VM that is loading its applications while another
# gleam compiles reads an empty .app file and dies at start (the first gleam-test run
# of CI run 42349388041). So after gleam-build the parts start the built code
# themselves (run_built: the same erl command gleam starts, without the compile) and
# run beside each other: glinter, generated-tables, gleam-test, real-start, real-tables,
# world-data and squirrel, and literal-area follows the two test runs. Every other part runs beside
# the chain.
#
# The committed message codec equals what the schema generates: the test
# the_committed_codec_is_what_the_schema_generates_test (test/message_codec_test.gleam)
# makes that comparison in gleam-test, the same one as
# `gleam run -m genesis_prime/generate_messages -- check`.

cd "$(dirname "${BASH_SOURCE[0]}")" || exit 1

# The clock starts here, before the setup check.
started=$(date +%s)

# The parts of the full check, in the order it lists them.
full_parts="format gleam-build glinter generated-tables gleam-test real-start real-tables world-data literal-area migrations squirrel client-suite fact-checker"

# The parts that start the code gleam-build built (run_built), in the order the chain starts them.
built_parts="glinter gap-tests code-rule-tests generated-tables squirrel real-start real-tables world-data gleam-test"

# in_list WORD LIST: succeeds when WORD is one of the words of LIST.
in_list() {
  case " $2 " in
    *" $1 "*) return 0 ;;
  esac
  return 1
}

# prerequisites_of PART: the parts PART needs, which a part run starts with it: gleam-build
# for each part that starts the built code, migrations for squirrel (the database it checks),
# and for client-suite gleam-build only where the client is, since only its client rows test
# reads the build.
prerequisites_of() {
  local needs=""
  in_list "$1" "$built_parts" && needs="gleam-build"
  case "$1" in
    squirrel) needs="$needs migrations" ;;
    client-suite) [ "${GENESIS_NO_CLIENT:-}" = 1 ] || needs="gleam-build" ;;
  esac
  echo "$needs"
}

usage() {
  echo "usage: ./check [fast]"
  echo "       ./check scope BASE         whether the files changed since BASE are all light: exit 0 for a light change, 1 for any other case"
  echo "       ./check part NAME [K/N]    one of: ${full_parts/ literal-area/}; K/N only for gleam-test, which needs it"
  exit 2
}

mode=${1:-full}
case "$mode" in
  full | fast) ;;
  scope)
    scope_base=${2:-}
    [ -n "$scope_base" ] && [ -z "${3:-}" ] || usage
    ;;
  part)
    part_name=${2:-}
    part_shard=${3:-}
    [ -z "${4:-}" ] || usage
    in_list "$part_name" "$full_parts" && [ "$part_name" != literal-area ] || usage
    if [ "$part_name" = gleam-test ]; then
      shard_number=${part_shard%%/*}
      shard_count=${part_shard#*/}
      case "$part_shard" in
        *[0-9]/[0-9]*) ;;
        *) usage ;;
      esac
      case "$shard_number$shard_count" in
        *[!0-9]*) usage ;;
      esac
      [ "$shard_number" -ge 1 ] && [ "$shard_number" -le "$shard_count" ] || usage
    else
      [ -z "$part_shard" ] || usage
    fi
    ;;
  *) usage ;;
esac

# The wall time the check may take, in seconds: the slowest of 3 full checks on the
# idle development Mac, with the parts beside each other and 2 test workers, was
# 125 s (119, 123 and 125 s), times 1.25, rounded up.
budget=${GENESIS_CHECK_BUDGET_SECONDS:-157}

# The same for ./check fast, with a warm build: the slowest of 3 runs on the
# development Mac, 2026-11-22, was 35 s (35, 35 and 35 s; glinter, 32 to 33 s, is
# its longest part), rounded up to 5 s.
fast_budget=${GENESIS_CHECK_FAST_BUDGET_SECONDS:-35}
if [ "$mode" = fast ]; then
  budget=$fast_budget
fi

client_scripts=.claude/skills/decoding-the-client/scripts

# How many module groups `gleam test` runs at once; each also runs up to one test
# per scheduler at once. 2 is the default: with the parts beside each other the
# full check took 146, 145 and 146 s with 1 and 119, 123 and 125 s with 2 on the
# idle development Mac (12 schedulers), and the first test run's literal area peaked
# at 80.4% with 1 and 76.2% with 2, under the 85% limit below (the world-data run,
# a VM of its own, 60.4% in every run). More than 2 would not shorten the check: the
# client suite, 118 to 123 s, is then its longest part.
test_workers=${GENESIS_TEST_WORKERS:-2}

# The literal region of the test VM, in bytes: literal_alloc's super carrier, 1024
# MiB unless +MIscs says otherwise (the check warns of that). A new carrier needs
# one free stretch of it, and a fill test in a fresh VM stopped at 97% of it, so
# a run that nears the region dies partway with `literal_alloc: Cannot allocate`.
# The client's tables are persistent terms held once for the run, and a `Tables`
# is only a handle of their keys and its own edits, so a copy of it (an ETS
# insert, a spawn, Ranch's protocol options) copies no table. The test VM's
# first run peaked at 717 MiB (70.0%) and the world-data VM's at 619 MiB
# (60.4%), under the 85% limit below. The limit is 85%: it warns at 870 MiB and
# leaves 154 MiB free, 1.4 times the largest table the suite puts (Spline2Node,
# 115.7 MB), and 123 MiB before the 97% where the VM dies. A run over it warns in
# the summary, so the margin cannot vanish unnoticed again; the limit is on the
# harness's own memory, so it never fails the check (a run that dies of it fails
# its tests). The limit is not set from outside: +MIscs only warns that the share
# is not of the default region, and a higher limit is a change to this line with
# the measurement that justifies it.
literal_region_bytes=1073741824
literal_limit_percent=85

# The machine's settings (env.sh) and the patched OTP first on PATH, before any part.
. setup_check/environment.sh

: "${PGHOST:=/tmp}"
: "${PGPORT:=5433}"
: "${PGUSER:=postgres}"
export PGHOST PGPORT PGUSER

# The parts of ./check fast that are parts of the full check too, which a full check whose
# branch is light also runs (CI's fast legs).
fast_parts="format gleam-build glinter fact-checker"

# The parts ./check fast runs besides them, and no other check does: the full check's
# gleam-test part runs their tests with the others, and CI's legs are the parts of the full
# check. Each runs the tests of one tag (tag_of_fast_part).
fast_tag_parts="gap-tests code-rule-tests"

# tag_of_fast_part PART: the tag whose tests the fast part PART runs.
tag_of_fast_part() {
  case "$1" in
    gap-tests) echo gaps ;;
    code-rule-tests) echo code_rule ;;
  esac
}

# The light set: the paths whose change no part beyond the fast parts reads. Each
# entry is "pattern|reason". A pattern is a shell glob in which `**` crosses
# folders; one without `**` matches only a path of its own depth, so `dev/*.sh`
# leaves out dev/genesis_prime/. Whatever the set does not name is not light,
# among it the fact file and the client's scripts (the fact checker and the client
# suite read them), check and setup_check (the setup check's tests), and the
# sources.
light_set=(
  "CLAUDE.md|guidance: no part reads it"
  ".claude/skills/**/*.md|guidance: no part reads it"
  ".claude/agents/**|guidance: no part reads it"
  "LICENSE|the licence text: no part reads it"
  ".gitignore|which files git skips: no part reads it"
  "dev/*.sh|a shell tool beside the code: no part tests it"
  "dev/*.py|a Python tool beside the code: no part tests it"
)

# The paths the light set's globs would take that are not light, as "path|reason".
light_set_except=(
  "dev/apply_migrations.sh|the migrations part runs it"
)

# slash_count PATH: how many `/` PATH holds.
slash_count() {
  local slashes=${1//[!\/]/}
  echo "${#slashes}"
}

# in_light_set PATH: succeeds when PATH matches an entry of the light set and none
# of light_set_except.
in_light_set() {
  local entry pattern
  for entry in "${light_set_except[@]}"; do
    [ "$1" = "${entry%%|*}" ] && return 1
  done
  for entry in "${light_set[@]}"; do
    pattern=${entry%%|*}
    case "$pattern" in
      *'**'*) pattern=${pattern//'**'/*} ;;
      *) [ "$(slash_count "$1")" = "$(slash_count "$pattern")" ] || continue ;;
    esac
    # shellcheck disable=SC2254 # the pattern is a glob on purpose
    case "$1" in
      $pattern) return 0 ;;
    esac
  done
  return 1
}

# history_is_shallow: succeeds when the repository's history is shallow.
history_is_shallow() {
  [ "$(git rev-parse --is-shallow-repository 2>/dev/null)" = true ]
}

# merge_base: prints the merge base of HEAD with origin/main, or with main when
# there is no origin/main; prints nothing when there is neither.
merge_base() {
  git merge-base HEAD origin/main 2>/dev/null || git merge-base HEAD main 2>/dev/null
}

# changed_files BASE [PATH...]: sets changed_list to the files, one per line, that
# the working tree changes since BASE (committed or not, deleted or renamed ones
# under both names, untracked ones too), limited to the PATHs when there are any.
# Fails, with changed_files_error naming the git command that failed, when git
# cannot say.
changed_files() {
  local base=$1 tracked untracked
  shift
  if ! tracked=$(git -c core.quotePath=false diff --name-only --no-renames "$base" -- "$@" 2>&1); then
    changed_files_error="git diff failed (${tracked%%$'\n'*})"
    return 1
  fi
  if ! untracked=$(git -c core.quotePath=false ls-files --others --exclude-standard -- "$@" 2>&1); then
    changed_files_error="git ls-files failed (${untracked%%$'\n'*})"
    return 1
  fi
  changed_list=$(printf '%s\n%s\n' "$tracked" "$untracked" | sed '/^$/d')
}

# scope_since BASE LABEL: sets scope to light or full, and scope_why to the reason, from the
# files the working tree changes since BASE (LABEL names BASE in the reason): light only when
# there is at least one and every one is in the light set, full wherever they are not known
# (a git command that failed).
scope_since() {
  local base=$1 label=$2 path count=0 first=""
  scope=full
  if ! changed_files "$base"; then
    scope_why="$changed_files_error, so the files the branch changes are not known"
    return
  fi
  if [ -z "$changed_list" ]; then
    scope_why="the branch changes no file since $label"
    return
  fi
  while IFS= read -r path; do
    if ! in_light_set "$path"; then
      scope_why="the branch changes $path since $label, which is not in the light set"
      return
    fi
    count=$((count + 1))
    [ -n "$first" ] || first=$path
  done <<<"$changed_list"
  scope=light
  scope_why="the $count files the branch changes since $label (first: $first) are all guidance or tools that no other part reads"
}

# decide_scope: the scope of a local full check, from the files the branch changes since its
# merge base with main. It is full on CI's machine (GENESIS_NO_CLIENT=1, which a CI run without
# the client's data secret sets, or GITHUB_ACTIONS), whose runs name their parts or ask
# `./check scope`, and wherever the changed files are not known: no merge base, a shallow
# history, or a git command that failed.
decide_scope() {
  local base
  scope=full
  if [ "${GENESIS_NO_CLIENT:-}" = 1 ] || [ -n "${GITHUB_ACTIONS:-}" ]; then
    scope_why="this is CI's machine (GENESIS_NO_CLIENT=1 or GITHUB_ACTIONS is set), which runs a part by name"
    return
  fi
  if history_is_shallow; then
    scope_why="the history is shallow, so the merge base with main cannot be established"
    return
  fi
  base=$(merge_base)
  if [ -z "$base" ]; then
    scope_why="there is no merge base with origin/main or main to find the changed files from"
    return
  fi
  scope_since "$base" "its merge base with main"
}

# ./check scope BASE: CI's pull request run asks which legs to run. The checkout there is the
# merge commit of the head into the base, so BASE is its first parent and the changed files are
# the pull request's. It prints the scope line and ends with 0 for a light change and 1 for any
# other case, before anything is started or made.
if [ "$mode" = scope ]; then
  scope_since "$scope_base" "$scope_base"
  if [ "$scope" = light ]; then
    echo "scope: light, because $scope_why"
    exit 0
  fi
  echo "scope: every part, because $scope_why"
  exit 1
fi

work=$(mktemp -d)
database="genesis_check_$$_${started}"
case "$mode" in
  full) parts=$full_parts ;;
  fast) parts="$fast_parts $fast_tag_parts" ;;
  part)
    needed="$part_name $(prerequisites_of "$part_name")"
    parts=""
    for part in $full_parts; do
      in_list "$part" "$needed" && parts="${parts:+$parts }$part"
    done
    scope_label=" (part $part_name${part_shard:+ $part_shard})"
    ;;
esac


# skip NAME REASON: records that the part did not run on purpose, and why.
skip() {
  echo "$2" >"$work/$1.skipped"
}

# descendants_of PID: the process ids of everything PID started, children,
# their children and so on, from one snapshot of the process table.
descendants_of() {
  ps -A -o pid= -o ppid= | awk -v root="$1" '
    { parent[$1] = $2 }
    END {
      for (p in parent) {
        q = p
        while ((q in parent) && q != root && q != 0 && q != 1) q = parent[q]
        if (q == root && p != root) print p
      }
    }'
}

# stop_everything PID: ends everything PID started: asks first, then kills what
# is still there, twice, for what was started in between.
stop_everything() {
  local pids
  pids=$(descendants_of "$1")
  [ -n "$pids" ] && kill -TERM $pids 2>/dev/null
  sleep 1
  for _ in 1 2; do
    pids=$(descendants_of "$1")
    [ -n "$pids" ] && kill -KILL $pids 2>/dev/null
  done
  return 0
}

# The hang limit is three times the budget: a watchdog sends this shell USR1 when
# it is reached, and the handler ends everything the check started, so a part or a
# setup check that hangs cannot hold the check for ever.
hung=no
on_hung() {
  hung=yes
  stop_everything $$
}
trap on_hung USR1

# stop_everything_quickly PID: kills PID and everything it started, at once. PID is
# frozen first: a PID still starting a process (the watchdog's sleep) would otherwise start
# it between the snapshot and the kill, and that process, left without its parent, would
# keep the check's output open until it ended.
stop_everything_quickly() {
  local pids
  kill -STOP "$1" 2>/dev/null
  pids=$(descendants_of "$1")
  kill -KILL $1 $pids 2>/dev/null
  return 0
}

# drop_database: drops the check's database, for at most 3 seconds: Postgres may
# have stopped answering, and the deadline that ended the check is already spent.
drop_database() {
  local pid waited=0
  PGCONNECT_TIMEOUT=3 psql -X -q -d postgres -c "drop database if exists \"$database\" with (force)" \
    >/dev/null 2>&1 &
  pid=$!
  while kill -0 "$pid" 2>/dev/null && [ "$waited" -lt 30 ]; do
    sleep 0.1
    waited=$((waited + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    stop_everything_quickly "$pid"
  fi
  return 0
}

cleanup() {
  if [ -f "$work/database_created" ]; then
    drop_database
  fi
  [ -n "${watchdog:-}" ] && stop_everything_quickly "$watchdog"
  rm -rf "$work"
}
trap cleanup EXIT
# Ctrl-C or a TERM ends what the parts started too; a normal end has nothing left to stop,
# so it does not pay the second stop_everything sleeps.
trap 'stop_everything $$; exit 130' INT TERM

# branch_current: the first part of the full check. Prints one line, and ends the
# check when HEAD lacks commits of origin/main as last fetched.
branch_current() {
  local behind tip noun=commits
  if ! tip=$(git rev-parse --short --verify --quiet origin/main 2>/dev/null); then
    printf '  %-18s skipped (there is no origin/main to compare with)\n' branch-current
    return
  fi
  if history_is_shallow; then
    printf '  %-18s skipped (the history is shallow, so whether HEAD holds origin/main cannot be established)\n' branch-current
    return
  fi
  if ! behind=$(git rev-list --count HEAD..origin/main); then
    echo "check FAILED: branch-current: git could not count the commits of origin/main that HEAD lacks, so no other part ran"
    exit 1
  fi
  if [ "$behind" = 0 ]; then
    printf '  %-18s ok      HEAD holds origin/main (tip %s)\n' branch-current "$tip"
    return
  fi
  [ "$behind" = 1 ] && noun=commit
  echo "check FAILED: branch-current: HEAD lacks $behind $noun of origin/main (tip $tip): merge origin/main first, so no other part ran"
  exit 1
}

if [ "$mode" = full ]; then
  branch_current
  decide_scope
  if [ "$scope" = light ]; then
    mode=fast
    parts=$fast_parts
    scope_label=" (scope: light)"
    budget=$fast_budget
    echo "scope: light, so only the fast parts run ($fast_parts): $scope_why; CI decides the same with ./check scope"
  else
    echo "scope: every part, because $scope_why"
  fi
elif [ "$mode" = part ]; then
  echo "scope: part $part_name, so only it and the parts it needs run ($parts)"
fi

# The watchdog: USR1 to this shell when the hang limit is reached.
hang_limit=$((3 * budget))
(
  remaining=$((started + hang_limit - $(date +%s)))
  [ "$remaining" -gt 0 ] || remaining=0
  sleep "$remaining"
  kill -USR1 $$ 2>/dev/null
) &
watchdog=$!

# The setup check comes first: when it fails, nothing else runs. It runs in the
# background and is waited for, so the deadline can end it.
./setup-check &
wait $!
setup_status=$?
if [ "$hung" = yes ]; then
  echo
  echo "check FAILED: the setup check hung, still running at three times its budget of ${budget}s"
  echo "wall time $(($(date +%s) - started))s, budget ${budget}s"
  exit 1
fi
if [ "$setup_status" != 0 ]; then
  echo
  echo "check FAILED: the setup check failed, so no other part ran"
  exit 1
fi


# run_built MODULE [ARGUMENTS...]: starts the code `gleam build` already built, the way
# `gleam run -m MODULE -- ARGUMENTS` does (`gleam test` is the module
# genesis_prime_test), without compiling: erl with -pa for each package's ebin, the
# entry module genesis_prime@@main (the package's name) running MODULE, -noshell, and
# the arguments after -extra, where the argv package reads them. The program's exit
# status is the function's. MODULE is written as gleam's -m takes it (a folder
# separator is `/`).
run_built() {
  local module=$1 dir paths=()
  shift
  for dir in "$PWD"/build/dev/erlang/*/ebin; do
    [ -d "$dir" ] && paths+=(-pa "$dir")
  done
  erl "${paths[@]}" -eval "genesis_prime@@main:run(${module//\//@})" -noshell -extra "$@"
}

# step NAME COMMAND...: runs the command here, its output to a log, and records
# its status and seconds under NAME; a part with a started record and no status
# was running when the check stopped.
step() {
  local name=$1 status begin
  shift
  begin=$(date +%s)
  touch "$work/$name.started"
  "$@" >"$work/$name.log" 2>&1
  status=$?
  echo "$status" >"$work/$name.status"
  echo $(($(date +%s) - begin)) >"$work/$name.seconds"
  return $status
}

# in_background COMMAND...: runs the command in the background, and remembers its
# process id, so the check waits for the parts and not for the watchdog.
part_pids=()
in_background() {
  ("$@") &
  part_pids+=("$!")
}

prepare_database() {
  psql -X -q -v ON_ERROR_STOP=1 -d postgres -c "create database \"$database\"" || return 1
  touch "$work/database_created"
  dev/apply_migrations.sh "$database"
}

database_url() {
  local host=$PGHOST
  case "$host" in
    /*) host=${PGTCPHOST:-::1} ;;
  esac
  case "$host" in
    *:*) host="[$host]" ;;
  esac
  local login=$PGUSER
  if [ -n "${PGPASSWORD:-}" ]; then
    login="$PGUSER:$PGPASSWORD"
  fi
  echo "postgres://$login@$host:$PGPORT/$database"
}

# wait_for_status NAME: waits until the part NAME has written its status, and
# succeeds when it is 0. It has no limit of its own: the hang limit stops the
# whole check, so a part that needs it is skipped only when it really failed.
wait_for_status() {
  local name=$1
  while [ ! -f "$work/$name.status" ]; do
    sleep 0.2
  done
  [ "$(cat "$work/$name.status" 2>/dev/null)" = 0 ]
}

# The tests tagged serial share a machine-wide resource (a child node's epmd and
# ports), so they run one at a time, in a second run; the first run skips them
# (GENESIS_TEST_SKIP_SERIAL, read by test/genesis_prime_test.gleam). The test tagged
# world_data, which takes about a minute alone, is the world-data part's: the first
# run skips it too (GENESIS_TEST_SKIP_WORLD_DATA); so is the test tagged real_start,
# which boots the real server in a node of its own and takes most of a minute, the
# real-start part's (GENESIS_TEST_SKIP_REAL_START); the tests tagged real_tables, which
# read the client's whole tables and take minutes together, are the real-tables part's
# (GENESIS_TEST_SKIP_REAL_TABLES); and the test tagged client_rows, which reads the
# client's committed rows against the client's tables, is the client-suite part's
# (GENESIS_TEST_SKIP_CLIENT_ROWS).
#
# Both runs print unitest's table of each test's duration (--reporter table, without
# colour), which test_module_times adds up per module for the summary.
#
# The first run also keeps the literal allocator's highest carriers size in
# $work/literal-peak (GENESIS_LITERAL_PEAK_FILE, read by test/genesis_prime_test.gleam),
# which the literal-area part compares with its limit. The serial run is left
# out: it runs a few tests alone, in a VM of its own.
#
# A shard (part gleam-test K/N) gives both runs its folder of symlinks
# (GENESIS_TEST_DIRECTORY) and fails when its first run ran no test, because a folder
# that came out empty must not pass. The serial run may run none: a shard holds a serial
# test only by chance.

# heavy_modules: the test modules a shard places first, as `module:seconds`, with the
# seconds of each module's tests in CI run 45126989760, the check of a branch that holds
# the split of game_wire_test (the summary's ten slowest modules, all from the one run so the
# seconds share a scale). The tail of the other modules has no measure and goes by hash. The
# ten split 203.4, 181.6 and 224.0 seconds over three shards.
heavy_modules="table_value_test:102.5 account_store_test:78.9 apply_migrations_test:66.7 game_wire_quest_test:58.1 objective_test:56.9 migration_start_test:56.7 sigterm_test:56.7 spell_area_test:45.8 spell_plan_lasting_test:44.2 limited_action_set_test:42.5"

# shard_files NUMBER COUNT: prints the path below test of each .gleam file under test/ that
# shard NUMBER of COUNT owns, one a line, by the rule in the header (equal seconds of two
# heavy modules go by name, so the order of heavy_modules does not matter). The hash stays
# below 2^53 so every awk computes the same.
shard_files() {
  (cd test && find . -type f -name '*.gleam' | sed 's|^\./||' | LC_ALL=C sort) |
    LC_ALL=C awk -v number="$1" -v count="$2" -v heavy="$heavy_modules" '
      BEGIN {
        for (i = 32; i < 127; i++) byte[sprintf("%c", i)] = i
        entries = split(heavy, entry, " ")
        for (i = 1; i <= entries; i++) {
          split(entry[i], pair, ":")
          name[i] = pair[1]
          seconds[i] = pair[2] + 0
        }
        for (i = 2; i <= entries; i++) {
          for (j = i; j > 1 && (seconds[j] > seconds[j - 1] || (seconds[j] == seconds[j - 1] && name[j] < name[j - 1])); j--) {
            swap = name[j]; name[j] = name[j - 1]; name[j - 1] = swap
            swap = seconds[j]; seconds[j] = seconds[j - 1]; seconds[j - 1] = swap
          }
        }
        for (shard = 1; shard <= count; shard++) load[shard] = 0
        for (i = 1; i <= entries; i++) {
          least = 1
          for (shard = 2; shard <= count; shard++) if (load[shard] < load[least]) least = shard
          owner[name[i]] = least
          load[least] += seconds[i]
        }
      }
      {
        module = $0
        sub(/\.gleam$/, "", module)
        if (module in owner) {
          shard = owner[module]
        } else {
          hash = 0
          for (i = 1; i <= length(module); i++) hash = (hash * 31 + byte[substr(module, i, 1)]) % 1000003
          shard = hash % count + 1
        }
        if (shard == number) print $0
      }'
}

# link_test_folder ROOT FILES: makes ROOT/test, empty first, holding a symlink to each file of
# FILES (paths below test, one a line), at the same path below test, so module names stay the
# same. The folder's path is left in shard_folder.
link_test_folder() {
  local root=$1 files=$2 relative
  shard_folder="$root/test"
  rm -rf "$root"
  mkdir -p "$shard_folder" || return 1
  while IFS= read -r relative; do
    [ -n "$relative" ] || continue
    case "$relative" in
      */*) mkdir -p "$shard_folder/${relative%/*}" || return 1 ;;
    esac
    ln -s "$PWD/test/$relative" "$shard_folder/$relative" || return 1
  done <<<"$files"
}

# shard_directory NUMBER COUNT: the folder of the files shard_files names for shard NUMBER
# of COUNT, build/chosen_tests/shard-NUMBER-of-COUNT/test.
shard_directory() {
  local files
  files=$(shard_files "$1" "$2") || return 1
  link_test_folder "build/chosen_tests/shard-$1-of-$2" "$files"
}

# test_run NAME [VARIABLE=VALUE...] -- ARGUMENTS...: one run of the built tests, in a shell
# of its own so its variables reach no other run: its tests are listed in $work/NAME.running
# (GENESIS_TEST_PROGRESS_FILE) and each VARIABLE=VALUE is set for it. A VM that dies by a
# signal (an abort, or a kill for memory, 9) prints the signal and the tests that had
# started and not ended (`still running:` lines, as the hang report has them), and the
# run fails with the VM's status.
test_run() {
  local name=$1 status
  shift
  (
    export GENESIS_TEST_PROGRESS_FILE="$work/$name.running"
    while [ "$1" != -- ]; do
      export "$1"
      shift
    done
    shift
    run_built genesis_prime_test "$@"
  )
  status=$?
  if [ "$status" -gt 128 ]; then
    echo "the test VM of $name died by signal $((status - 128)); the tests it had started and not ended:"
    running_tests "$name" | sed 's/^/  still running: /'
  fi
  return $status
}

# ran_a_test LOG: succeeds when unitest's summary in LOG counts more than 0 passed tests.
ran_a_test() {
  local passed
  passed=$(sed -n 's/^\([0-9][0-9]*\) passed.*/\1/p' "$1" | tail -1)
  [ -n "$passed" ] && [ "$passed" -gt 0 ]
}

gleam_test() {
  local status=0 first_run=(--reporter table --no-color) shard=()
  local first_settings=(GENESIS_LITERAL_PEAK_FILE="$work/literal-peak" GENESIS_TEST_SKIP_SERIAL=1 GENESIS_TEST_SKIP_WORLD_DATA=1 GENESIS_TEST_SKIP_REAL_START=1 GENESIS_TEST_SKIP_CLIENT_ROWS=1 GENESIS_TEST_SKIP_REAL_TABLES=1)
  [ -z "$test_workers" ] || first_run=(--workers "$test_workers" --reporter table --no-color)
  if [ -n "${shard_count:-}" ]; then
    shard_directory "$shard_number" "$shard_count" || return 1
    shard=(GENESIS_TEST_DIRECTORY="$shard_folder")
    test_run gleam-test "${first_settings[@]}" "${shard[@]}" -- "${first_run[@]}" | tee "$work/gleam-test.first"
    [ "${PIPESTATUS[0]}" = 0 ] || status=1
    if ! ran_a_test "$work/gleam-test.first"; then
      echo "no test ran in shard $shard_number/$shard_count: its first run counted no passed test"
      status=1
    fi
  else
    test_run gleam-test "${first_settings[@]}" -- "${first_run[@]}" || status=1
  fi
  test_run gleam-test "${shard[@]}" -- --tag serial --reporter table --no-color || status=1
  return $status
}

# The parts that run the tests of one tag alone, in a VM of their own beside the first
# test run: a part's tag is its name with `_` for `-` (real-start runs real_start). Each
# is skipped where it cannot run (tagged_part_wanted), and gleam-test's runs skip its tag
# (GENESIS_TEST_SKIP_ plus the tag in capitals). A VM has a literal region of its own that
# the first run's peak does not include, so the parts in tagged_parts_with_a_peak keep
# the allocator's highest carriers size in $work/literal-peak-PART for literal-area to
# compare; the real-start VM holds the few terms of one test (the server runs in a node
# of its own), so it keeps none.
tagged_parts="real-start real-tables world-data"
tagged_parts_with_a_peak="real-tables world-data"

# tagged_part_needs PART: what the part needs to run, as the reason a skip states.
tagged_part_needs() {
  case "$1" in
    world-data) echo "the client's tables and GENESIS_WORLD_DATA (GENESIS_NO_CLIENT=1 or GENESIS_WORLD_DATA unset here)" ;;
    *) echo "the client's tables (GENESIS_NO_CLIENT=1 here)" ;;
  esac
}

# tagged_part_wanted PART: succeeds where the part's tests can run: they need the client's
# tables, as their own guards say, and the world-data test also Jim's world database
# (GENESIS_WORLD_DATA).
tagged_part_wanted() {
  [ "${GENESIS_NO_CLIENT:-}" != 1 ] || return 1
  [ "$1" != world-data ] || [ -n "${GENESIS_WORLD_DATA:-}" ]
}

# tagged_part_test PART: the tests of the part's tag alone.
tagged_part_test() {
  local part=$1 settings=()
  if in_list "$part" "$tagged_parts_with_a_peak"; then
    settings=(GENESIS_LITERAL_PEAK_FILE="$work/literal-peak-$part")
  fi
  test_run "$part" "${settings[@]}" -- --tag "${part//-/_}"
}

# fast_tag_test_run PART: the tests of the tag tag_of_fast_part names alone, in a run of their
# own beside glinter. unitest parses every file of its test folder before it picks a tag, so the
# run reads a folder of symlinks to the files that name the tag (`"TAG"`), which hold every test
# of it. A run that counts no passed test fails, as a shard's does: a folder that came out
# empty, or a tag no test carries, must not pass.
fast_tag_test_run() {
  local part=$1 tag files status=0
  tag=$(tag_of_fast_part "$part")
  files=$(cd test && grep -rl --include='*.gleam' "\"$tag\"" . | sed 's|^\./||' | sort) || return 1
  [ -n "$files" ] || {
    echo "no test file names the tag $tag"
    return 1
  }
  link_test_folder "build/chosen_tests/$part" "$files" || return 1
  test_run "$part" GENESIS_TEST_DIRECTORY="$shard_folder" -- --tag "$tag" --no-color | tee "$work/$part.run"
  [ "${PIPESTATUS[0]}" = 0 ] || status=1
  if ! ran_a_test "$work/$part.run"; then
    echo "no test tagged $tag ran: the run counted no passed test"
    status=1
  fi
  return $status
}

# running_tests PART: prints the tests the part's run had started and not ended, from
# the file `owned_test.run` lists them in (test/test_progress.gleam: a line
# `start ID SECONDS module:function` when a test begins, `end ID` when it ends), the
# longest-running first, as `module:function (N s)`, N the seconds since it began. It
# prints one line saying so when no test was running, and one when the part never
# listed a test (its run did not start one, or it is not a run of tests).
running_tests() {
  local file="$work/$1.running"
  if [ ! -f "$file" ]; then
    echo "no test had started"
    return 0
  fi
  local running
  running=$(awk -v now="$(date +%s)" '
    $1 == "start" { began[$2] = $3; name[$2] = $4; order[++count] = $2 }
    $1 == "end" { delete began[$2] }
    END { for (i = 1; i <= count; i++) if (order[i] in began) printf "%s (%d s)\n", name[order[i]], now - began[order[i]] }' "$file")
  if [ -n "$running" ]; then
    echo "$running"
  else
    echo "no test was running: the run hung outside a test"
  fi
}

# module_milliseconds LOG: prints `MILLISECONDS module` for each test module in the unitest
# tables of LOG: the sum of the durations of its passed and failed tests, from every table in
# the log (a skipped test has none). A row reads `| PASS | module | test | 67ms |`.
module_milliseconds() {
  awk -F'|' '
    $2 ~ /^ *(PASS|FAIL) *$/ && $5 ~ /[0-9]ms *$/ {
      module = $3
      gsub(/^ +| +$/, "", module)
      milliseconds = $5
      gsub(/[^0-9]/, "", milliseconds)
      total[module] += milliseconds
    }
    END { for (module in total) printf "%d %s\n", total[module], module }' "$1"
}

# test_module_times LOG: prints the ten test modules with the most test time in LOG, slowest
# first, as `    SECONDS s  module`. A module's tests run side by side, so the sum is the module's
# test time, not the span it took.
test_module_times() {
  module_milliseconds "$1" | sort -k1,1nr -k2,2 | head -10 |
    awk '{ printf "    %6.1f s  %s\n", $1 / 1000, $2 }'
}

# test_total_time LOG: prints the test time of all the modules of LOG added up, and how many
# there are, so the balance of the shards of gleam-test can be read from each one's summary.
test_total_time() {
  module_milliseconds "$1" |
    awk '{ total += $1; count++ } END { if (count) printf "  total test time: %.1f s in %d modules\n", total / 1000, count }'
}

# literal_peak_report FILE RUN LABEL: prints the peak the run RUN recorded in FILE as
# LABEL, then a `check WARNING` line (which the summary repeats) when it is over
# literal_limit_percent of the region, or when the run recorded none. It returns 0
# either way: the limit is on the harness's own memory, so it warns and never fails.
literal_peak_report() {
  local file=$1 run=$2 label=$3 peak
  peak=$(cat "$file" 2>/dev/null)
  case "$peak" in
    '' | *[!0-9]*)
      echo "check WARNING: no literal area peak recorded: the $run wrote none to $file, so the area's margin was not measured"
      return 0
      ;;
  esac
  echo "$label: peak $((peak / 1048576)) MiB of $((literal_region_bytes / 1048576)) MiB ($((peak * 1000 / literal_region_bytes / 10)).$((peak * 1000 / literal_region_bytes % 10))%), limit ${literal_limit_percent}%"
  if [ $((peak * 100)) -gt $((literal_region_bytes * literal_limit_percent)) ]; then
    echo "check WARNING: $label over ${literal_limit_percent}% of its region: a test run that holds more persistent terms than that dies with literal_alloc when one more is put (see the limit's reason in ./check); find what holds them before raising it"
  fi
  return 0
}

# literal_area_check: reports the highest carriers size of each run in literal_runs, the
# first test run (`test`) and the parts' own runs (each a VM with a region of its own),
# against literal_limit_percent of the region. It warns, and never fails, when one is over
# it, when a run that ran has none to compare, or when +MIscs is set. The lines it
# prints that start with `literal area` are the measures and the lines that start
# with `check WARNING` are the warnings, which the check prints under the parts.
literal_area_check() {
  local run
  case "${ERL_FLAGS:-} ${ERL_AFLAGS:-} ${ERL_ZFLAGS:-} ${ELIXIR_ERL_OPTIONS:-}" in
    *+MIscs*)
      echo "check WARNING: +MIscs set in ERL_FLAGS, ERL_AFLAGS, ERL_ZFLAGS or ELIXIR_ERL_OPTIONS: the limit is a share of the default 1 GiB literal region, so the area was not measured against it; unset it"
      return 0
      ;;
  esac
  for run in $literal_runs; do
    if [ "$run" = test ]; then
      literal_peak_report "$work/literal-peak" "test run" "literal area"
    elif [ ! -f "$work/$run.skipped" ]; then
      literal_peak_report "$work/literal-peak-$run" "$run run" "literal area of the $run run"
    fi
  done
  return 0
}

# The client scripts' tests that need no Ghidra, then, where the client's files are (not
# GENESIS_NO_CLIENT=1), the committed list of the tooltip tokens and the committed client
# rows against a fresh read of them. The rows' test starts on the code gleam-build built.
client_suite() {
  local status=0
  env GENESIS_INTEGRATION=0 python3.13 -I -m unittest discover -s "$client_scripts" -p 'test_*.py' || status=1
  if [ "${GENESIS_NO_CLIENT:-}" != 1 ]; then
    python3.13 -I "$client_scripts/client_files.py" tokens --check || status=1
    if wait_for_status gleam-build; then
      test_run client-suite -- --tag client_rows || status=1
    else
      echo "the committed client rows were not checked: gleam-build failed"
      status=1
    fi
  fi
  return $status
}

squirrel_check() {
  DATABASE_URL=$(database_url) run_built squirrel check
}

# squirrel_after_migrations: squirrel reads the database the migrations part made.
squirrel_after_migrations() {
  if wait_for_status migrations; then
    step squirrel squirrel_check
  else
    skip squirrel "a part it needs failed: migrations"
  fi
}

# start_built_part PART: starts the part on the built code beside the others, or records
# why it did not run, and remembers its process id (built_chain's pids and peak_pids).
start_built_part() {
  case "$1" in
    glinter) ( step glinter run_built glinter ) & ;;
    gap-tests | code-rule-tests) ( step "$1" fast_tag_test_run "$1" ) & ;;
    generated-tables)
      if [ "${GENESIS_NO_CLIENT:-}" = 1 ]; then
        skip generated-tables "the tables are compared with the client's tables (GENESIS_NO_CLIENT=1 here)"
        return
      fi
      ( step generated-tables run_built genesis_prime/table_generator check ) &
      ;;
    squirrel) ( squirrel_after_migrations ) & ;;
    real-start | real-tables | world-data)
      if ! tagged_part_wanted "$1"; then
        skip "$1" "the tests tagged ${1//-/_} need $(tagged_part_needs "$1")"
        return
      fi
      ( step "$1" tagged_part_test "$1" ) &
      ;;
  esac
  pids+=("$!")
  if in_list "$1" "$tagged_parts_with_a_peak"; then
    peak_pids+=("$!")
  fi
}

# built_chain: gleam-build, which compiles; after it no part compiles again (see the note
# above), so each part of chain_parts that reads the build starts with run_built and runs
# beside the others, the tests (gleam-test) in this shell, and literal-area follows the test
# runs when there are runs to report (literal_runs).
built_chain() {
  local pids=() peak_pids=() part
  if ! step gleam-build gleam build --warnings-as-errors; then
    for part in $chain_parts; do
      skip "$part" "a part it needs failed: gleam-build"
    done
    [ -z "$literal_runs" ] || skip literal-area "a part it needs failed: gleam-build"
    return
  fi
  for part in $chain_parts; do
    [ "$part" = gleam-test ] || start_built_part "$part"
  done
  if in_list gleam-test "$chain_parts"; then
    step gleam-test gleam_test
  fi
  [ "${#peak_pids[@]}" -eq 0 ] || wait "${peak_pids[@]}"
  [ -z "$literal_runs" ] || step literal-area literal_area_check
  [ "${#pids[@]}" -eq 0 ] || wait "${pids[@]}"
}

facts_with_the_client_named() {
  if [ "${GENESIS_NO_CLIENT:-}" != 1 ] && [ -z "${WILDSTAR_CLIENT_EXE:-}" ]; then
    WILDSTAR_CLIENT_EXE=$(python3.13 -I -c '
import sys
sys.path.insert(0, ".claude/skills/decoding-the-client/scripts")
import check_support
print(check_support.client_exe())')
    export WILDSTAR_CLIENT_EXE
  fi
  python3.13 -I .claude/skills/decoding-the-client/scripts/check_facts.py 2>&1 |
    tee "$work/facts.out"
  local status=${PIPESTATUS[0]}
  if [ "${GENESIS_NO_CLIENT:-}" != 1 ] && grep -q "name rule was not checked" "$work/facts.out"; then
    echo "the client is missing and GENESIS_NO_CLIENT is not 1, so the name rule did not run"
    return 1
  fi
  return "$status"
}

# The parts that start on the built code, and the runs whose literal area is reported: the
# first test run and the tagged parts' own runs in the full check, the runs a part run makes.
chain_parts=""
for part in $built_parts; do
  in_list "$part" "$parts" && chain_parts="${chain_parts:+$chain_parts }$part"
done
case "$mode" in
  full) literal_runs="test $tagged_parts_with_a_peak" ;;
  part)
    literal_runs=""
    [ "$part_name" != gleam-test ] || literal_runs="test"
    ! in_list "$part_name" "$tagged_parts_with_a_peak" || literal_runs="$part_name"
    ;;
  *) literal_runs="" ;;
esac

# includes_part PART: succeeds when the run includes the part.
includes_part() {
  in_list "$1" "$parts"
}

includes_part format && in_background step format gleam format --check src test dev
includes_part gleam-build && in_background built_chain
includes_part migrations && in_background step migrations prepare_database
includes_part client-suite && in_background step client-suite client_suite
includes_part fact-checker && in_background step fact-checker facts_with_the_client_named
wait "${part_pids[@]}"

failed=""
failed_names=""
hung_names=""
for part in $parts; do
  if [ -f "$work/$part.skipped" ]; then
    printf '  %-18s skipped (%s)\n' "$part" "$(cat "$work/$part.skipped")"
  elif [ ! -f "$work/$part.status" ]; then
    failed="$failed $part"
    if [ "$hung" = yes ] && [ -f "$work/$part.started" ]; then
      printf '  %-18s FAILED  hung: still running at three times its budget\n' "$part"
      if [ "$part" = gleam-test ] || in_list "$part" "$fast_tag_parts" || [ "$part" = client-suite ] || in_list "$part" "$tagged_parts"; then
        running_tests "$part" | sed 's/^/                       still running: /'
      fi
      hung_names="${hung_names:+$hung_names, }$part"
      continue
    elif [ "$hung" = yes ]; then
      printf '  %-18s FAILED  never started: the check was stopped as hung\n' "$part"
    else
      printf '  %-18s FAILED  never wrote its status\n' "$part"
    fi
    failed_names="${failed_names:+$failed_names, }$part"
  elif [ "$(cat "$work/$part.status")" = 0 ]; then
    printf '  %-18s ok      %ss\n' "$part" "$(cat "$work/$part.seconds")"
  else
    printf '  %-18s FAILED  %ss\n' "$part" "$(cat "$work/$part.seconds")"
    failed="$failed $part"
    failed_names="${failed_names:+$failed_names, }$part"
  fi
done

if [ -f "$work/gleam-test.log" ]; then
  seeds=$(grep -h '^Seed: ' "$work/gleam-test.log" | sed 's/^Seed: //' | tr '\n' ' ' | sed 's/ $//')
  [ -n "$seeds" ] && echo "  gleam-test seeds: $seeds"
fi

if [ -f "$work/literal-area.log" ]; then
  grep -h '^literal area' "$work/literal-area.log" | sed 's/^/  /'
fi

if [ -f "$work/gleam-test.log" ]; then
  module_times=$(test_module_times "$work/gleam-test.log")
  if [ -n "$module_times" ]; then
    echo "  slowest test modules (the sum of each module's test times, gleam-test part):"
    echo "$module_times"
    test_total_time "$work/gleam-test.log"
  fi
fi

for part in $failed; do
  echo
  echo "---- $part ----"
  if [ "$part" = gleam-test ] && [ -f "$work/$part.log" ]; then
    grep -v '^| \(PASS\|SKIP\) ' "$work/$part.log"
  elif [ -f "$work/$part.log" ]; then
    cat "$work/$part.log"
  else
    echo "(the part wrote no status and no log)"
  fi
done

elapsed=$(($(date +%s) - started))
echo
if [ -f "$work/literal-area.log" ]; then
  grep -h '^check WARNING: ' "$work/literal-area.log"
fi
# A test's warning follows the dots the reporter printed on its line, so it is
# cut out of the line rather than matched at its start.
for part in gleam-test $fast_tag_parts $tagged_parts; do
  if [ -f "$work/$part.log" ]; then
    grep -ho 'check WARNING: test .*' "$work/$part.log"
  fi
done
if [ "$hung" = no ] && [ "$elapsed" -gt "$budget" ]; then
  echo "check WARNING: over its budget, wall time ${elapsed}s, budget ${budget}s"
fi
if [ -n "$failed" ] || [ "$hung" = yes ]; then
  reasons=$failed_names
  if [ "$hung" = yes ]; then
    reasons="${reasons:+$reasons; }${hung_names:-the check} hung, still running at three times its budget of ${budget}s"
  fi
  echo "check FAILED: $reasons"
  echo "wall time ${elapsed}s, budget ${budget}s"
  exit 1
fi
echo "check passed${scope_label:-}, wall time ${elapsed}s, budget ${budget}s"
