{
  "permissions": {
    "deny": [
      "Edit(~/Projects/the-eldan-experiment/**)",
      "Edit(//Users/jimd/Projects/the-eldan-experiment/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/dev/session_state.sh"
          },
          {
            "type": "command",
            "command": "test -f \"$CLAUDE_PROJECT_DIR\"/dev/hooks/keep_awake.sh || exit 0; \"$CLAUDE_PROJECT_DIR\"/dev/hooks/keep_awake.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
